<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="MangaDl.Pages.ProfilePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{StaticResource BgBrush}">

    <ScrollViewer Style="{StaticResource PageScroller}">
        <StackPanel>
            <!-- Banner + avatar -->
            <Grid Height="180" Background="#FF2D1716" />
            <Grid Padding="40,0,40,0" ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Width="140" Height="140" CornerRadius="70" Margin="0,-64,0,0" Background="{StaticResource BgBrush}" Padding="6" VerticalAlignment="Top">
                    <Border CornerRadius="64" Background="#FF3A1518">
                        <TextBlock Text="U" FontSize="44" FontWeight="ExtraBold" Foreground="{StaticResource FgBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                </Border>
                <StackPanel Grid.Column="1" Margin="8,16,0,0">
                    <TextBlock Text="[Display name]" FontSize="30" FontWeight="Black" Foreground="{StaticResource FgBrush}" />
                    <TextBlock Text="@[username] · reading since [date]" FontSize="14" Foreground="{StaticResource FgSubtleBrush}" Margin="0,2,0,0" />
                </StackPanel>
                <Button Grid.Column="2" Content="Share" Style="{StaticResource GhostButton}" VerticalAlignment="Top" Margin="0,16,0,0" />
                <Button Grid.Column="3" Content="Edit Profile" Style="{StaticResource PrimaryButton}" VerticalAlignment="Top" Margin="0,16,0,0" Click="OnEdit" />
            </Grid>

            <Grid Padding="40,28,40,40" ColumnSpacing="32">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel Spacing="24">
                    <TextBlock Text="[Bio — a short line about what this reader likes.]" Style="{StaticResource Body}" FontSize="15" LineHeight="23" Foreground="{StaticResource FgStrongBrush}" />
                    <StackPanel Spacing="12">
                        <TextBlock Text="PINNED" Style="{StaticResource Eyebrow}" />
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Height="250" CornerRadius="12" Background="#FF3A1518" />
                            <Border Grid.Column="1" Height="250" CornerRadius="12" Background="#FF1A2433" />
                            <Border Grid.Column="2" Height="250" CornerRadius="12" Background="#FF2E2412" />
                            <Border Grid.Column="3" Height="250" CornerRadius="12" Background="#FF13282A" />
                        </Grid>
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="1" Spacing="20">
                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border CornerRadius="14" Background="{StaticResource SurfaceBrush}" Padding="14">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="[n]" Style="{StaticResource DisplayText}" FontSize="28" HorizontalAlignment="Center" />
                                <TextBlock Text="Chapters" Style="{StaticResource Caption}" HorizontalAlignment="Center" />
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="1" CornerRadius="14" Background="{StaticResource SurfaceBrush}" Padding="14">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="[n]" Style="{StaticResource DisplayText}" FontSize="28" HorizontalAlignment="Center" />
                                <TextBlock Text="Library" Style="{StaticResource Caption}" HorizontalAlignment="Center" />
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="2" CornerRadius="14" Background="{StaticResource SurfaceBrush}" Padding="14">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="[n]" Style="{StaticResource DisplayText}" FontSize="28" HorizontalAlignment="Center" />
                                <TextBlock Text="Day streak" Style="{StaticResource Caption}" HorizontalAlignment="Center" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <StackPanel Spacing="10">
                        <TextBlock Text="MILESTONES" Style="{StaticResource EyebrowMuted}" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Border CornerRadius="999" Background="{StaticResource AccentMutedBrush}" Padding="12,8">
                                <TextBlock Text="[Milestone]" FontSize="12" FontWeight="Bold" Foreground="{StaticResource AccentSoftBrush}" />
                            </Border>
                            <Border CornerRadius="999" Background="{StaticResource AccentMutedBrush}" Padding="12,8">
                                <TextBlock Text="[Milestone]" FontSize="12" FontWeight="Bold" Foreground="{StaticResource AccentSoftBrush}" />
                            </Border>
                            <Border CornerRadius="999" Background="{StaticResource AccentMutedBrush}" Padding="12,8">
                                <TextBlock Text="[Milestone]" FontSize="12" FontWeight="Bold" Foreground="{StaticResource AccentSoftBrush}" />
                            </Border>
                            <Border CornerRadius="999" BorderBrush="{StaticResource SwitchOffBrush}" BorderThickness="1" Padding="12,8">
                                <TextBlock Text="[Locked]" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource FgSubtleBrush}" />
                            </Border>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel>
                        <TextBlock Text="RECENT ACTIVITY" Style="{StaticResource EyebrowMuted}" Margin="0,0,0,6" />
                        <Border BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,0,0,1" Padding="0,8">
                            <TextBlock Text="Read Iron Lantern Ch. 112" FontSize="13" Foreground="{StaticResource FgStrongBrush}" />
                        </Border>
                        <Border BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,0,0,1" Padding="0,8">
                            <TextBlock Text="Finished Glass Garden" FontSize="13" Foreground="{StaticResource FgStrongBrush}" />
                        </Border>
                        <Border Padding="0,8">
                            <TextBlock Text="Added Ashen Blade to library" FontSize="13" Foreground="{StaticResource FgStrongBrush}" />
                        </Border>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</Page>
