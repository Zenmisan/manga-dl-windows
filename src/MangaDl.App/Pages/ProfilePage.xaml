<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="MangaDl.Pages.ProfilePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{StaticResource BgBrush}">

    <ScrollViewer Style="{StaticResource PageScroller}">
        <StackPanel>
            <!-- Banner + avatar -->
            <Grid Height="180" Background="#FF2D1716" />
            <Grid Padding="40,0,40,0" ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Width="140" Height="140" CornerRadius="70" Margin="0,-64,0,0" Background="{StaticResource BgBrush}" Padding="6" VerticalAlignment="Top">
                    <Border CornerRadius="64" Background="#FF3A1518">
                        <TextBlock Text="U" FontSize="44" FontWeight="ExtraBold" Foreground="{StaticResource FgBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                </Border>
                <StackPanel Grid.Column="1" Margin="8,16,0,0">
                    <TextBlock x:Name="DisplayNameText" Text="Reader" FontSize="30" FontWeight="Black" Foreground="{StaticResource FgBrush}" />
                    <TextBlock x:Name="UsernameText" Text="@reader · Reading offline" FontSize="14" Foreground="{StaticResource FgSubtleBrush}" Margin="0,2,0,0" />
                </StackPanel>
                <Button Grid.Column="2" Content="Share" Style="{StaticResource GhostButton}" VerticalAlignment="Top" Margin="0,16,0,0" Click="OnShare" />
                <Button Grid.Column="3" Content="Edit Profile" Style="{StaticResource PrimaryButton}" VerticalAlignment="Top" Margin="0,16,0,0" Click="OnEdit" />
            </Grid>

            <Grid Padding="40,28,40,40" ColumnSpacing="32">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel Spacing="24">
                    <TextBlock Text="[Bio — a short line about what this reader likes.]" Style="{StaticResource Body}" FontSize="15" LineHeight="23" Foreground="{StaticResource FgStrongBrush}" />
                    <StackPanel Spacing="12">
                        <TextBlock Text="PINNED" Style="{StaticResource Eyebrow}" />
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Height="250" CornerRadius="12" Background="#FF3A1518" />
                            <Border Grid.Column="1" Height="250" CornerRadius="12" Background="#FF1A2433" />
                            <Border Grid.Column="2" Height="250" CornerRadius="12" Background="#FF2E2412" />
                            <Border Grid.Column="3" Height="250" CornerRadius="12" Background="#FF13282A" />
                        </Grid>
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="1" Spacing="20">
                    <!-- Hunter Rank Card -->
                    <Border x:Name="RankCard" CornerRadius="16" Background="#FF1E293B" BorderBrush="#FF38BDF8" BorderThickness="1" Padding="16">
                        <StackPanel Spacing="10">
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock x:Name="RankTitleText" Text="E-Rank Novice" FontSize="20" FontWeight="Bold" Foreground="{StaticResource FgBrush}" />
                                    <TextBlock x:Name="RankTagText" Text="Awakened Novice" FontSize="12" Foreground="{StaticResource FgSubtleBrush}" Margin="0,2,0,0" />
                                </StackPanel>
                                <Border Grid.Column="1" x:Name="RankBadgeBorder" CornerRadius="8" Background="#FF27272A" Padding="10,4" VerticalAlignment="Center">
                                    <TextBlock x:Name="RankBadgeText" Text="E" FontSize="16" FontWeight="Black" Foreground="{StaticResource FgBrush}" />
                                </Border>
                            </Grid>

                            <Grid ColumnSpacing="8" Margin="0,4,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="READER EXP" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource FgSubtleBrush}" />
                                <TextBlock Grid.Column="1" x:Name="ScoreValueText" Text="0 EXP" FontSize="12" FontWeight="Bold" Foreground="{StaticResource FgBrush}" />
                            </Grid>

                            <ProgressBar x:Name="RankProgressBar" Value="0" Maximum="100" Height="6" CornerRadius="3" Foreground="{StaticResource AccentBrush}" />
                            <TextBlock x:Name="NextRankText" Text="Next: D-Rank Hunter at 500 EXP" FontSize="11" Foreground="{StaticResource FgSubtleBrush}" />
                        </StackPanel>
                    </Border>

                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border CornerRadius="14" Background="{StaticResource SurfaceBrush}" Padding="14">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock x:Name="ChaptersCountText" Text="0" Style="{StaticResource DisplayText}" FontSize="28" HorizontalAlignment="Center" />
                                <TextBlock Text="Chapters" Style="{StaticResource Caption}" HorizontalAlignment="Center" />
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="1" CornerRadius="14" Background="{StaticResource SurfaceBrush}" Padding="14">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock x:Name="LibraryCountText" Text="0" Style="{StaticResource DisplayText}" FontSize="28" HorizontalAlignment="Center" />
                                <TextBlock Text="Library" Style="{StaticResource Caption}" HorizontalAlignment="Center" />
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="2" CornerRadius="14" Background="{StaticResource SurfaceBrush}" Padding="14">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock x:Name="StreakCountText" Text="0" Style="{StaticResource DisplayText}" FontSize="28" HorizontalAlignment="Center" />
                                <TextBlock Text="Day streak" Style="{StaticResource Caption}" HorizontalAlignment="Center" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <StackPanel Spacing="10">
                        <Grid>
                            <TextBlock Text="MILESTONES" Style="{StaticResource EyebrowMuted}" VerticalAlignment="Center" />
                            <TextBlock x:Name="MilestonesUnlockedText" Text="0 unlocked" FontSize="11" Foreground="{StaticResource FgSubtleBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                        </Grid>
                        <StackPanel x:Name="MilestonesContainer" Spacing="8" />
                    </StackPanel>

                    <StackPanel>
                        <TextBlock Text="RECENT ACTIVITY" Style="{StaticResource EyebrowMuted}" Margin="0,0,0,6" />
                        <Border BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,0,0,1" Padding="0,8">
                            <TextBlock Text="Read Iron Lantern Ch. 112" FontSize="13" Foreground="{StaticResource FgStrongBrush}" />
                        </Border>
                        <Border BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,0,0,1" Padding="0,8">
                            <TextBlock Text="Finished Glass Garden" FontSize="13" Foreground="{StaticResource FgStrongBrush}" />
                        </Border>
                        <Border Padding="0,8">
                            <TextBlock Text="Added Ashen Blade to library" FontSize="13" Foreground="{StaticResource FgStrongBrush}" />
                        </Border>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</Page>
