<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="MangaDl.Pages.ForgotPasswordPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:c="using:MangaDl.Controls"
    Background="{StaticResource BgBrush}">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Grid Padding="64,72" Background="{StaticResource BloomBottomLeftBrush}" BorderBrush="{StaticResource DividerStrongBrush}" BorderThickness="0,0,1,0">
            <StackPanel VerticalAlignment="Bottom" Spacing="16">
                <TextBlock Text="RESET PASSWORD" Style="{StaticResource DisplayText}" FontSize="120" LineHeight="108" />
                <TextBlock Text="Enter your account email. We'll send a link to set a new password."
                           Style="{StaticResource BodyMuted}" FontSize="17" LineHeight="26" MaxWidth="440" HorizontalAlignment="Left" />
            </StackPanel>
        </Grid>

        <StackPanel Grid.Column="1" Padding="96,72" MaxWidth="612" HorizontalAlignment="Left" VerticalAlignment="Center" Spacing="16">
            <Button Content="Back to Sign In" Style="{StaticResource LinkButton}" FontSize="13" HorizontalAlignment="Left" Click="OnBack" />
            <StackPanel>
                <TextBlock Text="Email" Style="{StaticResource FieldLabel}" />
                <TextBox Text="you@example.com" Style="{StaticResource MdTextBox}" InputScope="EmailSmtpAddress" AutomationProperties.Name="Email" />
            </StackPanel>

            <Button x:Name="SendButton" Content="Send Reset Link" Style="{StaticResource PrimaryButtonLarge}" HorizontalAlignment="Stretch" Click="OnSend" />

            <StackPanel x:Name="SentState" Spacing="16" Visibility="Collapsed">
                <Button Style="{StaticResource SuccessButton}" Height="50" HorizontalAlignment="Stretch" IsHitTestVisible="False">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <c:MdIcon Kind="Check" Size="18" Foreground="{StaticResource SuccessTextBrush}" />
                        <TextBlock Text="Link Sent" FontSize="15" FontWeight="ExtraBold" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Border Style="{StaticResource ListCard}" Padding="16">
                    <TextBlock Text="If an account exists for that email, a reset link is on its way. Check your spam folder too."
                               Style="{StaticResource Body}" Foreground="{StaticResource FgStrongBrush}" LineHeight="21" />
                </Border>
                <Button x:Name="Resend" Content="Resend in 0:45" Style="{StaticResource LinkButton}" Foreground="{StaticResource FgMutedBrush}" FontSize="13" HorizontalAlignment="Left" IsEnabled="False" />
            </StackPanel>
        </StackPanel>
    </Grid>
</Page>
