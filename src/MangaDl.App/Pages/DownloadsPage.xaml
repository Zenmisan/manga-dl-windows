<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="MangaDl.Pages.DownloadsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:c="using:MangaDl.Controls"
    xmlns:m="using:MangaDl.Core"
    xmlns:h="using:MangaDl.Helpers"
    Background="{StaticResource BgBrush}">

    <Page.Resources>
        <DataTemplate x:Key="DownloadCard" x:DataType="m:DownloadItem">
            <Border Style="{StaticResource ListCard}" Padding="16,14">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Width="40" Height="60" CornerRadius="6" Background="{x:Bind h:X.Hex(Manga.Cover)}" />
                    <StackPanel Grid.Column="1" Spacing="8" VerticalAlignment="Center">
                        <Grid>
                            <TextBlock FontSize="14" FontWeight="Bold" Foreground="{StaticResource FgBrush}">
                                <Run Text="{x:Bind Manga.Title}" /><Run Text=" · " Foreground="{StaticResource FgSubtleBrush}" FontWeight="Medium" /><Run Text="{x:Bind Chapter}" Foreground="{StaticResource FgSubtleBrush}" FontWeight="Medium" />
                            </TextBlock>
                            <TextBlock Text="{x:Bind Status}" FontSize="12" FontWeight="Bold" Foreground="{x:Bind h:X.DownloadText(State)}" HorizontalAlignment="Right" />
                        </Grid>
                        <c:MdProgress Value="{x:Bind Progress}" Fill="{x:Bind h:X.DownloadBar(State)}" Height="4" />
                    </StackPanel>
                    <Button Grid.Column="2" Style="{StaticResource IconButton}" Background="{StaticResource SurfaceRaisedBrush}" CornerRadius="10"
                            Click="OnItemAction" AutomationProperties.Name="{x:Bind h:X.DownloadAction(State)}">
                        <c:MdIcon Kind="{x:Bind h:X.DownloadIcon(State)}" Size="18" />
                    </Button>
                    <Button Grid.Column="3" Style="{StaticResource IconButton}" Foreground="{StaticResource FgMutedBrush}"
                            Click="OnItemCancel" AutomationProperties.Name="Cancel download">
                        <c:MdIcon Kind="Close" Size="18" />
                    </Button>
                </Grid>
            </Border>
        </DataTemplate>
    </Page.Resources>

    <ScrollViewer Style="{StaticResource PageScroller}">
        <Grid Padding="40,28,40,40" ColumnSpacing="32">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="300" />
            </Grid.ColumnDefinitions>

            <StackPanel Spacing="20">
                <Grid ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="DOWNLOADS" Style="{StaticResource PageTitle}" VerticalAlignment="Center" />
                    <Button Grid.Column="1" Content="Clear Finished" Style="{StaticResource GhostButton}" VerticalAlignment="Center" Click="OnClearFinished" />
                    <Button x:Name="PauseAll" Grid.Column="2" Content="Pause All" Style="{StaticResource PrimaryButton}" VerticalAlignment="Center" Click="OnPauseAll" />
                </Grid>
                <Grid BorderBrush="{StaticResource DividerStrongBrush}" BorderThickness="0,0,0,1">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton x:Name="TabQueue" Content="Queue" GroupName="DlTabs" Style="{StaticResource TabRadio}" IsChecked="True" Checked="OnTabChecked" />
                        <RadioButton x:Name="TabFinished" Content="Finished" GroupName="DlTabs" Style="{StaticResource TabRadio}" Checked="OnTabChecked" />
                        <RadioButton x:Name="TabFailed" Content="Failed" GroupName="DlTabs" Style="{StaticResource TabRadio}" Checked="OnTabChecked" />
                    </StackPanel>
                </Grid>
                <ItemsRepeater ItemsSource="{x:Bind Items}" ItemTemplate="{StaticResource DownloadCard}">
                    <ItemsRepeater.Layout>
                        <StackLayout Spacing="8" />
                    </ItemsRepeater.Layout>
                </ItemsRepeater>
            </StackPanel>

            <Border Grid.Column="1" Style="{StaticResource ListCard}" Padding="20" CornerRadius="16" VerticalAlignment="Top" Margin="0,8,0,0">
                <StackPanel Spacing="14">
                    <TextBlock Text="SAVE TO" Style="{StaticResource Eyebrow}" />
                    <TextBlock x:Name="FolderText" Text="~/manga-library" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource FgBrush}" TextWrapping="Wrap" />
                    <Button Content="Change Folder" Style="{StaticResource GhostButton}" Height="40" CornerRadius="10" HorizontalAlignment="Stretch" Click="OnChangeFolder" />
                    <StackPanel Spacing="6">
                        <Grid>
                            <TextBlock Text="Format" FontSize="13" Foreground="{StaticResource FgMutedBrush}" />
                            <TextBlock Text="CBZ + ComicInfo" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource FgBrush}" HorizontalAlignment="Right" />
                        </Grid>
                        <Grid>
                            <TextBlock Text="Parallel downloads" FontSize="13" Foreground="{StaticResource FgMutedBrush}" />
                            <TextBlock Text="[n]" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource FgBrush}" HorizontalAlignment="Right" />
                        </Grid>
                        <Grid>
                            <TextBlock Text="Storage used" FontSize="13" Foreground="{StaticResource FgMutedBrush}" />
                            <TextBlock Text="—" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource FgBrush}" HorizontalAlignment="Right" />
                        </Grid>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </ScrollViewer>
</Page>
