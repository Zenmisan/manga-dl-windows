<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="MangaDl.Pages.ImportPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:c="using:MangaDl.Controls"
    xmlns:m="using:MangaDl.Core"
    xmlns:h="using:MangaDl.Helpers"
    Background="{StaticResource BgBrush}">

    <Page.Resources>
        <DataTemplate x:Key="ImportRow" x:DataType="m:ImportFile">
            <Border Style="{StaticResource ListCard}" Background="{StaticResource Surface4Brush}" Padding="16,12" CornerRadius="12">
                <Grid ColumnSpacing="14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Width="44" Height="36" CornerRadius="8" Background="{StaticResource SurfaceRaisedBrush}">
                        <TextBlock Text="{x:Bind Ext}" FontSize="10" FontWeight="Black" Foreground="{StaticResource FgBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Grid.Column="1" Spacing="6" VerticalAlignment="Center">
                        <Grid>
                            <TextBlock Text="{x:Bind Name}" FontSize="14" FontWeight="Bold" Foreground="{StaticResource FgBrush}" />
                            <TextBlock Text="{x:Bind Status}" FontSize="12" FontWeight="Bold" Foreground="{x:Bind h:X.ImportText(Kind)}" HorizontalAlignment="Right" />
                        </Grid>
                        <c:MdProgress Value="{x:Bind Progress}" Fill="{x:Bind h:X.ImportBar(Kind)}" Track="{StaticResource DividerStrongBrush}" Height="4" />
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>
    </Page.Resources>

    <ScrollViewer Style="{StaticResource PageScroller}">
        <Grid Padding="40,28,40,40" ColumnSpacing="32">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="320" />
            </Grid.ColumnDefinitions>

            <StackPanel Spacing="20">
                <TextBlock Text="IMPORT FILES" Style="{StaticResource PageTitle}" />

                <!-- Drop zone -->
                <Border x:Name="DropZone" Height="300" CornerRadius="20" BorderBrush="{StaticResource AccentBrush}" BorderThickness="2"
                        Background="{StaticResource AccentWashBrush}" AllowDrop="True" DragOver="OnDragOver" Drop="OnDrop" DragLeave="OnDragLeave">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="14">
                        <Border Width="64" Height="64" CornerRadius="18" Background="{StaticResource AccentMutedBrush}" HorizontalAlignment="Center">
                            <c:MdIcon Kind="Upload" Size="30" Foreground="{StaticResource AccentLightBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="Drop files to import" FontSize="22" FontWeight="Black" Foreground="{StaticResource FgBrush}" HorizontalAlignment="Center" />
                        <TextBlock Text="CBZ, ZIP, EPUB or folders of images" FontSize="14" Foreground="{StaticResource FgSoftBrush}" HorizontalAlignment="Center" />
                        <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center" Margin="0,6,0,0">
                            <Button Content="Choose Files" Style="{StaticResource PrimaryButton}" Height="44" Click="OnChooseFiles" />
                            <Button Content="Choose Folder" Style="{StaticResource GhostButton}" Height="44" Click="OnChooseFolder" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <TextBlock Text="THIS SESSION" Style="{StaticResource EyebrowMuted}" Margin="0,6,0,0" />
                <ItemsRepeater ItemsSource="{x:Bind Files}" ItemTemplate="{StaticResource ImportRow}">
                    <ItemsRepeater.Layout>
                        <StackLayout Spacing="8" />
                    </ItemsRepeater.Layout>
                </ItemsRepeater>
            </StackPanel>

            <StackPanel Grid.Column="1" Spacing="14" Margin="0,72,0,0">
                <Border Style="{StaticResource ListCard}" Background="{StaticResource Surface4Brush}" Padding="20" CornerRadius="16">
                    <StackPanel Spacing="4">
                        <TextBlock Text="IMPORT INTO" Style="{StaticResource Eyebrow}" Margin="0,0,0,8" />
                        <RadioButton Content="New series per folder" GroupName="ImportDest" IsChecked="True" FontSize="14" />
                        <RadioButton Content="Add to existing series" GroupName="ImportDest" FontSize="14" />
                        <CheckBox Content="Read ComicInfo.xml" IsChecked="True" Style="{StaticResource MdCheckBox}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource ListCard}" Background="{StaticResource Surface4Brush}" Padding="20" CornerRadius="16">
                    <StackPanel Spacing="8">
                        <TextBlock Text="TIPS" Style="{StaticResource EyebrowMuted}" />
                        <TextBlock Text="Name folders after the series. Files are sorted by volume and chapter numbers in their names."
                                   Style="{StaticResource Body}" FontSize="13" LineHeight="20" Foreground="{StaticResource FgSoftBrush}" />
                        <Button Content="Read the import guide" Style="{StaticResource LinkButton}" FontSize="13" HorizontalAlignment="Left" Padding="0,4" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>
