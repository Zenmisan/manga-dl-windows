<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="MangaDl.Pages.OnboardingPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:c="using:MangaDl.Controls"
    Background="{StaticResource BgBrush}">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Hero -->
        <Grid Padding="64,72" Background="{StaticResource BloomTopLeftBrush}" BorderBrush="{StaticResource DividerStrongBrush}" BorderThickness="0,0,1,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <StackPanel Spacing="20">
                <TextBlock Text="WELCOME TO MANGA-DL" Style="{StaticResource Eyebrow}" />
                <TextBlock Text="YOUR MANGA, EVERYWHERE." Style="{StaticResource DisplayText}" FontSize="104" LineHeight="96" />
            </StackPanel>
            <StackPanel Grid.Row="2" Spacing="14">
                <StackPanel Orientation="Horizontal" Spacing="14">
                    <Border Width="32" Height="32" CornerRadius="16" Background="{StaticResource SuccessSoftBrush}">
                        <c:MdIcon Kind="Check" Size="16" Foreground="{StaticResource SuccessTextBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="Welcome" Style="{StaticResource Body}" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource FgMutedBrush}" VerticalAlignment="Center" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="14">
                    <Border Width="32" Height="32" CornerRadius="16" Background="{StaticResource AccentBrush}">
                        <TextBlock Text="2" FontSize="13" FontWeight="ExtraBold" Foreground="{StaticResource WhiteBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="Connect to backend" Style="{StaticResource Body}" FontSize="15" FontWeight="ExtraBold" VerticalAlignment="Center" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="14">
                    <Border Width="32" Height="32" CornerRadius="16" BorderBrush="{StaticResource SwitchOffBrush}" BorderThickness="1">
                        <TextBlock Text="3" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource FgSubtleBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="Library folder &amp; account" Style="{StaticResource Body}" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource FgSubtleBrush}" VerticalAlignment="Center" />
                </StackPanel>
            </StackPanel>
        </Grid>

        <!-- Form -->
        <ScrollViewer Grid.Column="1" Style="{StaticResource PageScroller}">
            <Grid Padding="80,72" MaxWidth="620" HorizontalAlignment="Left" MinHeight="760">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <StackPanel Spacing="24">
                    <TextBlock Text="Connect to backend" Style="{StaticResource Body}" FontSize="28" FontWeight="Black" />
                    <TextBlock Text="The desktop app reads sources by itself. Add a backend only if you want sync and cloud backups. You can change this later in Settings."
                               Style="{StaticResource BodyMuted}" FontSize="15" LineHeight="23" />
                    <StackPanel>
                        <TextBlock Text="Backend URL" Style="{StaticResource FieldLabel}" />
                        <TextBox Text="https://[your-server]:8000" Style="{StaticResource MdTextBox}" InputScope="Url" AutomationProperties.Name="Backend URL" />
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="API key (optional)" Style="{StaticResource FieldLabel}" />
                        <PasswordBox Password="secretkey" Style="{StaticResource MdPasswordBox}" AutomationProperties.Name="API key" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <Button Content="Test Connection" Style="{StaticResource GhostButton}" Height="44" Click="OnTest" />
                        <StackPanel x:Name="Connected" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <c:MdIcon Kind="Check" Size="16" Foreground="{StaticResource SuccessTextBrush}" />
                            <TextBlock Text="Connected" FontSize="13" FontWeight="Bold" Foreground="{StaticResource SuccessTextBrush}" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
                <Grid Grid.Row="2" ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Button Content="Skip — Read Offline" Style="{StaticResource LinkButton}" FontSize="14" HorizontalAlignment="Left" Click="OnSkip" />
                    <Button Grid.Column="1" Content="Back" Style="{StaticResource GhostButtonLarge}" FontSize="14" Click="OnBack" />
                    <Button Grid.Column="2" Content="Continue" Style="{StaticResource PrimaryButtonLarge}" FontSize="14" Padding="28,0" Click="OnContinue" />
                </Grid>
            </Grid>
        </ScrollViewer>
    </Grid>
</Page>
