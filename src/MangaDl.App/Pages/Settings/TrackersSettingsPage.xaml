<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="MangaDl.Pages.Settings.TrackersSettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:c="using:MangaDl.Controls"
    xmlns:h="using:MangaDl.Helpers"
    xmlns:m="using:MangaDl.Core"
    Background="Transparent">

    <ScrollViewer Style="{StaticResource PageScroller}">
        <StackPanel Spacing="20" Padding="0,0,0,40" MaxWidth="1040" HorizontalAlignment="Left">
            <StackPanel>
                <TextBlock Text="Trackers" Style="{StaticResource SectionTitle}" />
                <TextBlock Text="Keep your lists on other sites in step with what you read here." Style="{StaticResource Caption}" FontSize="13" Margin="0,4,0,0" />
            </StackPanel>

            <ItemsRepeater ItemsSource="{x:Bind Trackers}">
                <ItemsRepeater.Layout>
                    <UniformGridLayout MaximumRowsOrColumns="3" MinItemWidth="300" MinItemHeight="176" MinRowSpacing="16" MinColumnSpacing="16" ItemsStretch="Fill" />
                </ItemsRepeater.Layout>
                <ItemsRepeater.ItemTemplate>
                    <DataTemplate x:DataType="m:Tracker">
                        <Border Style="{StaticResource Card}" BorderBrush="{x:Bind h:X.TrackerBorder(Connected)}">
                            <Grid RowSpacing="12">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <StackPanel Orientation="Horizontal" Spacing="12">
                                    <Border Width="44" Height="44" CornerRadius="12" Background="{x:Bind h:X.Hex(Color)}">
                                        <TextBlock Text="{x:Bind Short}" FontSize="13" FontWeight="Black" Foreground="{StaticResource FgBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{x:Bind Name}" FontSize="16" FontWeight="ExtraBold" Foreground="{StaticResource FgBrush}" />
                                        <TextBlock Text="{x:Bind h:X.TrackerState(Connected)}" FontSize="12" FontWeight="SemiBold" Foreground="{x:Bind h:X.TrackerStateColor(Connected)}" />
                                    </StackPanel>
                                </StackPanel>
                                <TextBlock Grid.Row="1" Text="{x:Bind Description}" Style="{StaticResource BodyMuted}" FontSize="13" TextWrapping="Wrap" />
                                <Button Grid.Row="2" Content="{x:Bind h:X.TrackerAction(Connected)}" Style="{x:Bind h:X.TrackerActionStyle(Connected)}" HorizontalAlignment="Left" Click="OnTrackerAction" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsRepeater.ItemTemplate>
            </ItemsRepeater>

            <Border Style="{StaticResource FaintCard}" MaxWidth="620" HorizontalAlignment="Left">
                <StackPanel>
                    <TextBlock Text="SYNC" Style="{StaticResource Eyebrow}" Margin="0,0,0,6" />
                    <c:SettingRow Label="Update progress after reading" Description="Send the chapter number when you finish a chapter.">
                        <ToggleButton Style="{StaticResource MdSwitch}" IsChecked="True" />
                    </c:SettingRow>
                    <c:SettingRow Label="Mark as reading on first chapter">
                        <ToggleButton Style="{StaticResource MdSwitch}" IsChecked="True" />
                    </c:SettingRow>
                    <c:SettingRow Label="Mark as completed on last chapter">
                        <ToggleButton Style="{StaticResource MdSwitch}" IsChecked="True" />
                    </c:SettingRow>
                    <c:SettingRow Label="Pull progress from trackers" Description="Mark chapters read here when a tracker is ahead." ShowDivider="False">
                        <ToggleButton Style="{StaticResource MdSwitch}" />
                    </c:SettingRow>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
