<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="MangaDl.Pages.Settings.ReaderSettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:c="using:MangaDl.Controls"
    Background="Transparent">

    <ScrollViewer Style="{StaticResource PageScroller}">
        <StackPanel Spacing="20" Padding="0,0,0,40" MaxWidth="1040" HorizontalAlignment="Left">
            <StackPanel>
                <TextBlock Text="Reader" Style="{StaticResource SectionTitle}" />
                <TextBlock Text="Defaults for every manga. You can override them per series from the reader." Style="{StaticResource Caption}" FontSize="13" Margin="0,4,0,0" />
            </StackPanel>

            <Grid ColumnSpacing="20" RowSpacing="20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Reading -->
                <Border Style="{StaticResource FaintCard}" VerticalAlignment="Top">
                    <StackPanel>
                        <TextBlock Text="READING" Style="{StaticResource Eyebrow}" Margin="0,0,0,6" />
                        <c:SettingRow Label="Reading mode">
                            <c:SettingRow.Below>
                                <Border Background="{StaticResource SurfaceRaisedBrush}" CornerRadius="10" Padding="3" HorizontalAlignment="Left">
                                    <StackPanel Orientation="Horizontal">
                                        <RadioButton Content="Left to right" GroupName="ReadMode" Style="{StaticResource SegmentRadio}" IsChecked="True" />
                                        <RadioButton Content="Right to left" GroupName="ReadMode" Style="{StaticResource SegmentRadio}" />
                                        <RadioButton Content="Vertical" GroupName="ReadMode" Style="{StaticResource SegmentRadio}" />
                                        <RadioButton Content="Webtoon" GroupName="ReadMode" Style="{StaticResource SegmentRadio}" />
                                    </StackPanel>
                                </Border>
                            </c:SettingRow.Below>
                        </c:SettingRow>
                        <c:SettingRow Label="Two-page spread" Description="Show pages side by side on wide windows.">
                            <ToggleButton Style="{StaticResource MdSwitch}" IsChecked="True" />
                        </c:SettingRow>
                        <c:SettingRow Label="Crop borders" Description="Trim white or black margins around pages.">
                            <ToggleButton Style="{StaticResource MdSwitch}" />
                        </c:SettingRow>
                        <c:SettingRow Label="Webtoon side padding" Description="Narrow the strip on wide screens." ShowDivider="False">
                            <c:SettingRow.Below>
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="44" />
                                    </Grid.ColumnDefinitions>
                                    <Slider x:Name="PaddingSlider" Minimum="0" Maximum="40" Value="15" StepFrequency="5" ValueChanged="OnPaddingChanged" />
                                    <TextBlock x:Name="PaddingValue" Grid.Column="1" Text="15%" FontSize="13" FontWeight="ExtraBold" Foreground="{StaticResource FgBrush}" VerticalAlignment="Center" TextAlignment="Right" />
                                </Grid>
                            </c:SettingRow.Below>
                        </c:SettingRow>
                    </StackPanel>
                </Border>

                <!-- Display -->
                <Border Grid.Column="1" Style="{StaticResource FaintCard}" VerticalAlignment="Top">
                    <StackPanel>
                        <TextBlock Text="DISPLAY" Style="{StaticResource Eyebrow}" Margin="0,0,0,6" />
                        <c:SettingRow Label="Page fit">
                            <c:SettingRow.Below>
                                <Border Background="{StaticResource SurfaceRaisedBrush}" CornerRadius="10" Padding="3" HorizontalAlignment="Left">
                                    <StackPanel Orientation="Horizontal">
                                        <RadioButton Content="Fit height" GroupName="ReadFit" Style="{StaticResource SegmentRadio}" IsChecked="True" />
                                        <RadioButton Content="Fit width" GroupName="ReadFit" Style="{StaticResource SegmentRadio}" />
                                        <RadioButton Content="Original" GroupName="ReadFit" Style="{StaticResource SegmentRadio}" />
                                    </StackPanel>
                                </Border>
                            </c:SettingRow.Below>
                        </c:SettingRow>
                        <c:SettingRow Label="Background">
                            <c:SettingRow.Below>
                                <Border Background="{StaticResource SurfaceRaisedBrush}" CornerRadius="10" Padding="3" HorizontalAlignment="Left">
                                    <StackPanel Orientation="Horizontal">
                                        <RadioButton Content="Black" GroupName="ReadBg" Style="{StaticResource SegmentRadio}" IsChecked="True" />
                                        <RadioButton Content="Gray" GroupName="ReadBg" Style="{StaticResource SegmentRadio}" />
                                        <RadioButton Content="White" GroupName="ReadBg" Style="{StaticResource SegmentRadio}" />
                                    </StackPanel>
                                </Border>
                            </c:SettingRow.Below>
                        </c:SettingRow>
                        <c:SettingRow Label="Show page number">
                            <ToggleButton Style="{StaticResource MdSwitch}" IsChecked="True" />
                        </c:SettingRow>
                        <c:SettingRow Label="Open in fullscreen" ShowDivider="False">
                            <ToggleButton Style="{StaticResource MdSwitch}" />
                        </c:SettingRow>
                    </StackPanel>
                </Border>

                <!-- Controls -->
                <Border Grid.Row="1" Style="{StaticResource FaintCard}" VerticalAlignment="Top">
                    <StackPanel>
                        <TextBlock Text="CONTROLS" Style="{StaticResource Eyebrow}" Margin="0,0,0,6" />
                        <c:SettingRow Label="Click zones" Description="Click the left or right edge to turn pages.">
                            <ToggleButton Style="{StaticResource MdSwitch}" IsChecked="True" />
                        </c:SettingRow>
                        <c:SettingRow Label="Mouse wheel">
                            <c:SettingRow.Below>
                                <Border Background="{StaticResource SurfaceRaisedBrush}" CornerRadius="10" Padding="3" HorizontalAlignment="Left">
                                    <StackPanel Orientation="Horizontal">
                                        <RadioButton Content="Scroll" GroupName="ReadWheel" Style="{StaticResource SegmentRadio}" IsChecked="True" />
                                        <RadioButton Content="Turn page" GroupName="ReadWheel" Style="{StaticResource SegmentRadio}" />
                                        <RadioButton Content="Zoom" GroupName="ReadWheel" Style="{StaticResource SegmentRadio}" />
                                    </StackPanel>
                                </Border>
                            </c:SettingRow.Below>
                        </c:SettingRow>
                        <c:SettingRow Label="Keyboard shortcuts" Description="← → turn pages · F fullscreen · Esc exit" ShowDivider="False">
                            <Button Content="Customise" Style="{StaticResource SmallGhostButton}" Click="OnCustomiseShortcuts" />
                        </c:SettingRow>
                    </StackPanel>
                </Border>

                <!-- Image filters -->
                <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource FaintCard}" VerticalAlignment="Top">
                    <StackPanel>
                        <TextBlock Text="IMAGE FILTERS" Style="{StaticResource Eyebrow}" Margin="0,0,0,6" />
                        <c:SettingRow Label="Brightness">
                            <c:SettingRow.Below>
                                <Slider Minimum="-50" Maximum="50" Value="0" StepFrequency="5" AutomationProperties.Name="Brightness" />
                            </c:SettingRow.Below>
                        </c:SettingRow>
                        <c:SettingRow Label="Grayscale">
                            <ToggleButton Style="{StaticResource MdSwitch}" />
                        </c:SettingRow>
                        <c:SettingRow Label="Invert colours">
                            <ToggleButton Style="{StaticResource MdSwitch}" />
                        </c:SettingRow>
                        <c:SettingRow Label="Sharpen scaled pages" ShowDivider="False">
                            <ToggleButton Style="{StaticResource MdSwitch}" IsChecked="True" />
                        </c:SettingRow>
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</Page>
