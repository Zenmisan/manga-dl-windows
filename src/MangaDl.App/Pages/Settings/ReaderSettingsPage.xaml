<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="MangaDl.Pages.Settings.ReaderSettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:c="using:MangaDl.Controls"
    Background="Transparent">

    <ScrollViewer Style="{StaticResource PageScroller}">
        <StackPanel Spacing="20" Padding="0,0,0,40" MaxWidth="1040" HorizontalAlignment="Left">
            <StackPanel>
                <TextBlock Text="Reader" Style="{StaticResource SectionTitle}" />
                <TextBlock Text="Defaults for every manga. You can override them per series from the reader." Style="{StaticResource Caption}" FontSize="13" Margin="0,4,0,0" />
            </StackPanel>

            <Grid ColumnSpacing="20" RowSpacing="20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Reading -->
                <Border Style="{StaticResource FaintCard}" VerticalAlignment="Top">
                    <StackPanel>
                        <TextBlock Text="READING" Style="{StaticResource Eyebrow}" Margin="0,0,0,6" />
                        <c:SettingRow Label="Reading mode">
                            <c:SettingRow.Below>
                                <Border Background="{StaticResource SurfaceRaisedBrush}" CornerRadius="10" Padding="3" HorizontalAlignment="Left">
                                    <StackPanel Orientation="Horizontal">
                                        <RadioButton x:Name="ModeLtr" Content="Left to right" GroupName="ReadMode" Style="{StaticResource SegmentRadio}" Checked="OnReadingModeChanged" />
                                        <RadioButton x:Name="ModeRtl" Content="Right to left" GroupName="ReadMode" Style="{StaticResource SegmentRadio}" Checked="OnReadingModeChanged" />
                                        <RadioButton x:Name="ModeVertical" Content="Vertical" GroupName="ReadMode" Style="{StaticResource SegmentRadio}" Checked="OnReadingModeChanged" />
                                        <RadioButton x:Name="ModeWebtoon" Content="Webtoon" GroupName="ReadMode" Style="{StaticResource SegmentRadio}" Checked="OnReadingModeChanged" />
                                    </StackPanel>
                                </Border>
                            </c:SettingRow.Below>
                        </c:SettingRow>
                        <c:SettingRow Label="Two-page spread" Description="Show pages side by side on wide windows.">
                            <ToggleButton x:Name="TwoPageSpreadToggle" Style="{StaticResource MdSwitch}" Checked="OnTwoPageSpreadToggled" Unchecked="OnTwoPageSpreadToggled" />
                        </c:SettingRow>
                        <c:SettingRow Label="Crop borders" Description="Trim white or black margins around pages.">
                            <ToggleButton x:Name="CropBordersToggle" Style="{StaticResource MdSwitch}" Checked="OnCropBordersToggled" Unchecked="OnCropBordersToggled" />
                        </c:SettingRow>
                        <c:SettingRow Label="Webtoon side padding" Description="Narrow the strip on wide screens." ShowDivider="False">
                            <c:SettingRow.Below>
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="44" />
                                    </Grid.ColumnDefinitions>
                                    <Slider x:Name="PaddingSlider" Minimum="0" Maximum="40" Value="15" StepFrequency="5" ValueChanged="OnPaddingChanged" />
                                    <TextBlock x:Name="PaddingValue" Grid.Column="1" Text="15%" FontSize="13" FontWeight="ExtraBold" Foreground="{StaticResource FgBrush}" VerticalAlignment="Center" TextAlignment="Right" />
                                </Grid>
                            </c:SettingRow.Below>
                        </c:SettingRow>
                    </StackPanel>
                </Border>

                <!-- Display -->
                <Border Grid.Column="1" Style="{StaticResource FaintCard}" VerticalAlignment="Top">
                    <StackPanel>
                        <TextBlock Text="DISPLAY" Style="{StaticResource Eyebrow}" Margin="0,0,0,6" />
                        <c:SettingRow Label="Page fit">
                            <c:SettingRow.Below>
                                <Border Background="{StaticResource SurfaceRaisedBrush}" CornerRadius="10" Padding="3" HorizontalAlignment="Left">
                                    <StackPanel Orientation="Horizontal">
                                        <RadioButton x:Name="FitHeight" Content="Fit height" GroupName="ReadFit" Style="{StaticResource SegmentRadio}" Checked="OnPageFitChanged" />
                                        <RadioButton x:Name="FitWidth" Content="Fit width" GroupName="ReadFit" Style="{StaticResource SegmentRadio}" Checked="OnPageFitChanged" />
                                        <RadioButton x:Name="FitOriginal" Content="Original" GroupName="ReadFit" Style="{StaticResource SegmentRadio}" Checked="OnPageFitChanged" />
                                    </StackPanel>
                                </Border>
                            </c:SettingRow.Below>
                        </c:SettingRow>
                        <c:SettingRow Label="Background">
                            <c:SettingRow.Below>
                                <Border Background="{StaticResource SurfaceRaisedBrush}" CornerRadius="10" Padding="3" HorizontalAlignment="Left">
                                    <StackPanel Orientation="Horizontal">
                                        <RadioButton x:Name="BgBlack" Content="Black" GroupName="ReadBg" Style="{StaticResource SegmentRadio}" Checked="OnBackgroundChanged" />
                                        <RadioButton x:Name="BgGray" Content="Gray" GroupName="ReadBg" Style="{StaticResource SegmentRadio}" Checked="OnBackgroundChanged" />
                                        <RadioButton x:Name="BgWhite" Content="White" GroupName="ReadBg" Style="{StaticResource SegmentRadio}" Checked="OnBackgroundChanged" />
                                    </StackPanel>
                                </Border>
                            </c:SettingRow.Below>
                        </c:SettingRow>
                        <c:SettingRow Label="Show page number">
                            <ToggleButton x:Name="ShowPageNumberToggle" Style="{StaticResource MdSwitch}" Checked="OnShowPageNumberToggled" Unchecked="OnShowPageNumberToggled" />
                        </c:SettingRow>
                        <c:SettingRow Label="Open in fullscreen" ShowDivider="False">
                            <ToggleButton x:Name="OpenFullscreenToggle" Style="{StaticResource MdSwitch}" Checked="OnOpenFullscreenToggled" Unchecked="OnOpenFullscreenToggled" />
                        </c:SettingRow>
                    </StackPanel>
                </Border>

                <!-- Controls -->
                <Border Grid.Row="1" Style="{StaticResource FaintCard}" VerticalAlignment="Top">
                    <StackPanel>
                        <TextBlock Text="CONTROLS" Style="{StaticResource Eyebrow}" Margin="0,0,0,6" />
                        <c:SettingRow Label="Click zones" Description="Click the left or right edge to turn pages.">
                            <ToggleButton x:Name="ClickZonesToggle" Style="{StaticResource MdSwitch}" Checked="OnClickZonesToggled" Unchecked="OnClickZonesToggled" />
                        </c:SettingRow>
                        <c:SettingRow Label="Mouse wheel">
                            <c:SettingRow.Below>
                                <Border Background="{StaticResource SurfaceRaisedBrush}" CornerRadius="10" Padding="3" HorizontalAlignment="Left">
                                    <StackPanel Orientation="Horizontal">
                                        <RadioButton x:Name="WheelScroll" Content="Scroll" GroupName="ReadWheel" Style="{StaticResource SegmentRadio}" Checked="OnMouseWheelChanged" />
                                        <RadioButton x:Name="WheelTurnPage" Content="Turn page" GroupName="ReadWheel" Style="{StaticResource SegmentRadio}" Checked="OnMouseWheelChanged" />
                                        <RadioButton x:Name="WheelZoom" Content="Zoom" GroupName="ReadWheel" Style="{StaticResource SegmentRadio}" Checked="OnMouseWheelChanged" />
                                    </StackPanel>
                                </Border>
                            </c:SettingRow.Below>
                        </c:SettingRow>
                        <c:SettingRow Label="Keyboard shortcuts" Description="← → turn pages · F fullscreen · Esc exit" ShowDivider="False">
                            <Button Content="Customise" Style="{StaticResource SmallGhostButton}" Click="OnCustomiseShortcuts" />
                        </c:SettingRow>
                    </StackPanel>
                </Border>

                <!-- Image filters -->
                <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource FaintCard}" VerticalAlignment="Top">
                    <StackPanel>
                        <TextBlock Text="IMAGE FILTERS" Style="{StaticResource Eyebrow}" Margin="0,0,0,6" />
                        <c:SettingRow Label="Brightness">
                            <c:SettingRow.Below>
                                <Slider x:Name="BrightnessSlider" Minimum="-50" Maximum="50" Value="0" StepFrequency="5" AutomationProperties.Name="Brightness" ValueChanged="OnBrightnessChanged" />
                            </c:SettingRow.Below>
                        </c:SettingRow>
                        <c:SettingRow Label="Grayscale">
                            <ToggleButton x:Name="GrayscaleToggle" Style="{StaticResource MdSwitch}" Checked="OnGrayscaleToggled" Unchecked="OnGrayscaleToggled" />
                        </c:SettingRow>
                        <c:SettingRow Label="Invert colours">
                            <ToggleButton x:Name="InvertToggle" Style="{StaticResource MdSwitch}" Checked="OnInvertToggled" Unchecked="OnInvertToggled" />
                        </c:SettingRow>
                        <c:SettingRow Label="Sharpen scaled pages" ShowDivider="False">
                            <ToggleButton x:Name="SharpenToggle" Style="{StaticResource MdSwitch}" Checked="OnSharpenToggled" Unchecked="OnSharpenToggled" />
                        </c:SettingRow>
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</Page>
