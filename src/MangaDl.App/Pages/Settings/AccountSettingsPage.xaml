<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="MangaDl.Pages.Settings.AccountSettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:c="using:MangaDl.Controls"
    Background="Transparent">

    <ScrollViewer Style="{StaticResource PageScroller}">
        <StackPanel Spacing="20" Padding="0,0,0,40" MaxWidth="1040" HorizontalAlignment="Left">
            <StackPanel>
                <TextBlock Text="Account" Style="{StaticResource SectionTitle}" />
                <TextBlock Text="Your profile, sync and sign-in." Style="{StaticResource Caption}" FontSize="13" Margin="0,4,0,0" />
            </StackPanel>

            <!-- Profile summary -->
            <Border Style="{StaticResource Card}">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Width="64" Height="64" CornerRadius="32" Background="#FF3A1518">
                        <TextBlock Text="U" FontSize="24" FontWeight="ExtraBold" Foreground="{StaticResource FgBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock x:Name="ProfileNameText" Text="Reader" FontSize="18" FontWeight="ExtraBold" Foreground="{StaticResource FgBrush}" />
                        <TextBlock x:Name="UsernameEmailText" Text="Not signed in" Style="{StaticResource Caption}" FontSize="13" Margin="0,2,0,0" />
                    </StackPanel>
                    <Button Grid.Column="2" Content="View profile" Style="{StaticResource GhostButton}" VerticalAlignment="Center" Click="OnViewProfile" />
                </Grid>
            </Border>

            <Grid ColumnSpacing="20" RowSpacing="20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Public profile -->
                <Border Grid.RowSpan="2" Style="{StaticResource FaintCard}" VerticalAlignment="Top">
                    <StackPanel Spacing="14">
                        <TextBlock Text="PUBLIC PROFILE" Style="{StaticResource Eyebrow}" />
                        <StackPanel Spacing="6">
                            <TextBlock Text="Display name" Style="{StaticResource FieldLabel}" />
                            <TextBox x:Name="DisplayNameBox" Style="{StaticResource MdTextBox}" PlaceholderText="[Display name]" AutomationProperties.Name="Display name" />
                        </StackPanel>
                        <StackPanel Spacing="6">
                            <TextBlock Text="Bio" Style="{StaticResource FieldLabel}" />
                            <TextBox x:Name="BioBox" Style="{StaticResource MdTextBox}" PlaceholderText="A short line about what you like to read" AcceptsReturn="True" TextWrapping="Wrap" Height="96" AutomationProperties.Name="Bio" />
                        </StackPanel>
                        <StackPanel Spacing="6">
                            <TextBlock Text="Avatar URL" Style="{StaticResource FieldLabel}" />
                            <Grid ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Width="40" Height="40" CornerRadius="20" Background="{StaticResource SurfaceRaisedBrush}">
                                    <Image x:Name="AvatarPreview" Stretch="UniformToFill" />
                                </Border>
                                <TextBox Grid.Column="1" x:Name="AvatarUrlBox" Style="{StaticResource MdTextBox}" PlaceholderText="https://example.com/avatar.png" AutomationProperties.Name="Avatar URL" TextChanged="OnAvatarUrlChanged" VerticalAlignment="Center" />
                            </Grid>
                        </StackPanel>
                        <c:SettingRow Label="Show reading activity" Description="Let others see what you're reading and your stats.">
                            <ToggleButton Style="{StaticResource MdSwitch}" IsChecked="True" />
                        </c:SettingRow>
                        <StackPanel Spacing="6">
                            <TextBlock Text="Account server" Style="{StaticResource FieldLabel}" />
                            <TextBox x:Name="BackendUrlBox" Style="{StaticResource MdTextBox}" PlaceholderText="https://api.manga-dl.app (leave blank to skip cross-platform profile/comments)" AutomationProperties.Name="Account server URL" />
                        </StackPanel>
                        <TextBlock x:Name="BackendStatusText" Style="{StaticResource Caption}" FontSize="12" Visibility="Collapsed" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Content="Save changes" Style="{StaticResource PrimaryButton}" Click="OnSave" />
                            <Button Content="Test connection" Style="{StaticResource GhostButton}" Click="OnTestBackend" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Cloud sync -->
                <Border Grid.Column="1" Style="{StaticResource Card}" Background="{StaticResource SuccessWashBrush}" BorderBrush="{StaticResource SuccessLineBrush}">
                    <StackPanel Spacing="10">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Border Width="36" Height="36" CornerRadius="10" Background="{StaticResource SuccessSoftBrush}">
                                <c:MdIcon Kind="CloudCheck" Size="18" Foreground="{StaticResource SuccessTextBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Cloud sync is on" FontSize="15" FontWeight="ExtraBold" Foreground="{StaticResource FgBrush}" />
                                <TextBlock x:Name="SyncStatusText" Text="Sync ready · Connected to Supabase" Style="{StaticResource Caption}" Foreground="{StaticResource SuccessTextBrush}" />
                            </StackPanel>
                        </StackPanel>
                        <TextBlock Text="Library, progress, categories and settings follow you across Android, Windows and Linux." Style="{StaticResource BodyMuted}" TextWrapping="Wrap" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button x:Name="SyncButton" Content="Sync now" Style="{StaticResource SuccessButton}" Click="OnSyncNow" />
                            <Button Content="Manage devices" Style="{StaticResource GhostButton}" Click="OnManageDevices" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Sign-in -->
                <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource FaintCard}">
                    <StackPanel>
                        <TextBlock Text="SIGN-IN" Style="{StaticResource Eyebrow}" Margin="0,0,0,6" />
                        <c:SettingRow x:Name="EmailRow" Label="Email" Description="[email]">
                            <Button Content="Change" Style="{StaticResource SmallGhostButton}" Click="OnChangeEmail" />
                        </c:SettingRow>
                        <c:SettingRow Label="Password" Description="Last changed [date]">
                            <Button Content="Change" Style="{StaticResource SmallGhostButton}" Click="OnChangePassword" />
                        </c:SettingRow>
                        <c:SettingRow Label="Sign out" Description="Downloads stay on this PC." ShowDivider="False">
                            <Button x:Name="SignOutButton" Content="Sign out" Style="{StaticResource SmallDangerButton}" Click="OnSignOut" />
                        </c:SettingRow>

                        <!-- Inline confirmation -->
                        <Border x:Name="SignOutConfirm" Visibility="Collapsed" Margin="0,10,0,0" Padding="14" CornerRadius="12"
                                Background="{StaticResource ErrorSoftBrush}" BorderBrush="{StaticResource ErrorBorderBrush}" BorderThickness="1">
                            <StackPanel Spacing="10">
                                <TextBlock Text="Sign out of manga-dl on this PC?" FontSize="14" FontWeight="Bold" Foreground="{StaticResource FgBrush}" />
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button Content="Sign out" Style="{StaticResource SmallDangerButton}" Click="OnConfirmSignOut" />
                                    <Button Content="Cancel" Style="{StaticResource SmallGhostButton}" Click="OnCancelSignOut" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</Page>
