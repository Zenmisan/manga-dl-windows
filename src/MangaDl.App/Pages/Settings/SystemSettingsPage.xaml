<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="MangaDl.Pages.Settings.SystemSettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:c="using:MangaDl.Controls"
    Background="Transparent">

    <ScrollViewer Style="{StaticResource PageScroller}">
        <StackPanel Spacing="20" Padding="0,0,0,40" MaxWidth="1040" HorizontalAlignment="Left">
            <StackPanel>
                <TextBlock Text="System &amp; backup" Style="{StaticResource SectionTitle}" />
                <TextBlock Text="Storage, backups, servers and app updates." Style="{StaticResource Caption}" FontSize="13" Margin="0,4,0,0" />
            </StackPanel>

            <Grid ColumnSpacing="20" RowSpacing="20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Storage -->
                <Border Style="{StaticResource FaintCard}" VerticalAlignment="Top">
                    <StackPanel>
                        <TextBlock Text="STORAGE" Style="{StaticResource Eyebrow}" Margin="0,0,0,10" />
                        <Grid Margin="0,0,0,8">
                            <TextBlock x:Name="StorageUsedText" Text="-- GB used" FontSize="20" FontWeight="ExtraBold" Foreground="{StaticResource FgBrush}" />
                            <TextBlock x:Name="StorageFreeText" Text="of -- GB total" Style="{StaticResource Caption}" HorizontalAlignment="Right" VerticalAlignment="Bottom" />
                        </Grid>
                        <c:MdProgress x:Name="StorageProgressBar" Value="0" Height="8" />
                        <StackPanel Orientation="Horizontal" Spacing="16" Margin="0,10,0,6">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Ellipse Width="8" Height="8" Fill="{StaticResource AccentBrush}" VerticalAlignment="Center" />
                                <TextBlock x:Name="DownloadsStorageText" Text="Downloads --" Style="{StaticResource Caption}" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Ellipse Width="8" Height="8" Fill="{StaticResource FgFaintBrush}" VerticalAlignment="Center" />
                                <TextBlock x:Name="CacheStorageText" Text="Cache --" Style="{StaticResource Caption}" />
                            </StackPanel>
                        </StackPanel>
                        <c:SettingRow x:Name="DownloadLocationRow" Label="Download location" Description="C:\Users\[user]\Documents\manga-dl">
                            <Button Content="Change" Style="{StaticResource SmallGhostButton}" Click="OnChangeLocation" />
                        </c:SettingRow>
                        <c:SettingRow Label="Clear image cache" Description="Covers and pages you've read online." ShowDivider="False">
                            <Button Content="Clear" Style="{StaticResource SmallGhostButton}" Click="OnClearCache" />
                        </c:SettingRow>
                    </StackPanel>
                </Border>

                <!-- Backup -->
                <Border Grid.Column="1" Style="{StaticResource FaintCard}" VerticalAlignment="Top">
                    <StackPanel>
                        <TextBlock Text="BACKUP" Style="{StaticResource Eyebrow}" Margin="0,0,0,6" />
                        <c:SettingRow Label="Create backup" Description="Library, categories, progress and settings.">
                            <Button Content="Create" Style="{StaticResource SmallPrimaryButton}" Click="OnBackup" />
                        </c:SettingRow>
                        <c:SettingRow Label="Restore backup" Description="From a .mangadl or Tachiyomi backup file.">
                            <Button Content="Restore" Style="{StaticResource SmallGhostButton}" Click="OnRestore" />
                        </c:SettingRow>
                        <c:SettingRow Label="Automatic backups" Description="Last backup [date]" ShowDivider="False">
                            <ComboBox SelectedIndex="2" MinWidth="130" CornerRadius="10">
                                <ComboBoxItem Content="Off" />
                                <ComboBoxItem Content="Daily" />
                                <ComboBoxItem Content="Weekly" />
                                <ComboBoxItem Content="Monthly" />
                            </ComboBox>
                        </c:SettingRow>
                    </StackPanel>
                </Border>

                <!-- Sync -->
                <Border Grid.Row="1" Style="{StaticResource FaintCard}" VerticalAlignment="Top">
                    <StackPanel>
                        <TextBlock Text="SYNC" Style="{StaticResource Eyebrow}" Margin="0,0,0,6" />
                        <c:SettingRow Label="Sync library" Description="Across every device signed in to your account.">
                            <ToggleButton Style="{StaticResource MdSwitch}" IsChecked="True" />
                        </c:SettingRow>
                        <c:SettingRow Label="Sync reading progress">
                            <ToggleButton Style="{StaticResource MdSwitch}" IsChecked="True" />
                        </c:SettingRow>
                        <c:SettingRow Label="Sync settings" ShowDivider="False">
                            <ToggleButton Style="{StaticResource MdSwitch}" />
                        </c:SettingRow>
                    </StackPanel>
                </Border>

                <!-- Servers -->
                <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource FaintCard}" VerticalAlignment="Top">
                    <StackPanel>
                        <TextBlock Text="SERVERS" Style="{StaticResource Eyebrow}" Margin="0,0,0,6" />
                        <c:SettingRow Label="Local server" Description="http://localhost:4567 · running">
                            <Border Background="{StaticResource SuccessSoftBrush}" CornerRadius="999" Padding="10,4">
                                <TextBlock Text="Online" FontSize="12" FontWeight="Bold" Foreground="{StaticResource SuccessTextBrush}" />
                            </Border>
                        </c:SettingRow>
                        <c:SettingRow Label="Remote servers" Description="Add another manga-dl server to read from." ShowDivider="False">
                            <Button Content="Add server" Style="{StaticResource SmallGhostButton}" Click="OnAddServer" />
                        </c:SettingRow>
                    </StackPanel>
                </Border>

                <!-- About -->
                <Border Grid.Row="2" Grid.ColumnSpan="2" Style="{StaticResource FaintCard}">
                    <Grid ColumnSpacing="20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Image Source="ms-appx:///Assets/Square44x44Logo.png" Width="48" Height="48" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="MANGA-DL" Style="{StaticResource DisplayText}" FontSize="22" />
                            <TextBlock Text="Version 1.0.0 · up to date" Style="{StaticResource Caption}" FontSize="13" />
                            <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,8,0,0">
                                <ToggleButton x:Name="AutoInstall" Style="{StaticResource MdSwitch}" IsChecked="True" AutomationProperties.Name="Install updates automatically" />
                                <TextBlock Text="Install updates automatically" FontSize="13" Foreground="{StaticResource FgSoftBrush}" VerticalAlignment="Center" />
                            </StackPanel>
                        </StackPanel>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <Button Content="Release notes" Style="{StaticResource GhostButton}" Click="OnReleaseNotes" />
                            <Button Content="Restart &amp; Install" Style="{StaticResource PrimaryButton}" Click="OnInstall" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</Page>
