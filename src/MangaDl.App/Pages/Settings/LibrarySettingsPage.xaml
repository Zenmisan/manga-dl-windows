<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="MangaDl.Pages.Settings.LibrarySettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:c="using:MangaDl.Controls"
    xmlns:local="using:MangaDl.Pages.Settings"
    Background="Transparent">

    <ScrollViewer Style="{StaticResource PageScroller}">
        <StackPanel Spacing="20" Padding="0,0,0,40" MaxWidth="1040" HorizontalAlignment="Left">
            <StackPanel>
                <TextBlock Text="Library" Style="{StaticResource SectionTitle}" />
                <TextBlock Text="Categories, how the grid looks and when to check for new chapters." Style="{StaticResource Caption}" FontSize="13" Margin="0,4,0,0" />
            </StackPanel>

            <Grid ColumnSpacing="20" RowSpacing="20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Categories -->
                <Border Grid.RowSpan="2" Style="{StaticResource FaintCard}" VerticalAlignment="Top">
                    <StackPanel Spacing="12">
                        <Grid>
                            <TextBlock Text="CATEGORIES" Style="{StaticResource Eyebrow}" VerticalAlignment="Center" />
                            <Button Style="{StaticResource SmallPrimaryButton}" HorizontalAlignment="Right" Click="OnAdd">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <c:MdIcon Kind="Plus" Size="14" />
                                    <TextBlock Text="Add" />
                                </StackPanel>
                            </Button>
                        </Grid>

                        <!-- New category input -->
                        <Grid x:Name="AddRow" ColumnSpacing="8" Visibility="Collapsed">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="NewName" Style="{StaticResource MdTextBox}" PlaceholderText="Category name" AutomationProperties.Name="Category name" KeyDown="OnNewNameKey" />
                            <Button Grid.Column="1" Content="Save" Style="{StaticResource PrimaryButton}" Click="OnSaveNew" />
                            <Button Grid.Column="2" Content="Cancel" Style="{StaticResource GhostButton}" Click="OnCancelNew" />
                        </Grid>

                        <ItemsRepeater ItemsSource="{x:Bind Categories}">
                            <ItemsRepeater.Layout>
                                <StackLayout Spacing="6" />
                            </ItemsRepeater.Layout>
                            <ItemsRepeater.ItemTemplate>
                                <DataTemplate x:DataType="local:CategoryRow">
                                    <Border Background="{StaticResource SurfaceBrush}" CornerRadius="12" Padding="12,0,6,0" Height="52">
                                        <Grid ColumnSpacing="10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <c:MdIcon Kind="Grip" Size="16" Foreground="{StaticResource FgFaintBrush}" VerticalAlignment="Center" />
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="{x:Bind Name}" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource FgBrush}" />
                                                <TextBlock Text="{x:Bind Count}" Style="{StaticResource Caption}" />
                                            </StackPanel>
                                            <Button Grid.Column="2" Style="{StaticResource IconButton}" Width="36" Height="36" Tag="{x:Bind Name}" Click="OnRename"
                                                    AutomationProperties.Name="Rename" ToolTipService.ToolTip="Rename">
                                                <c:MdIcon Kind="Edit" Size="16" />
                                            </Button>
                                            <Button Grid.Column="3" Style="{StaticResource IconButton}" Width="36" Height="36" Tag="{x:Bind Name}" Click="OnDelete"
                                                    AutomationProperties.Name="Delete" ToolTipService.ToolTip="Delete">
                                                <c:MdIcon Kind="Trash" Size="16" />
                                            </Button>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsRepeater.ItemTemplate>
                        </ItemsRepeater>
                        <TextBlock Text="Drag to reorder. Deleting a category moves its manga to Default." Style="{StaticResource Caption}" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <!-- Display -->
                <Border Grid.Column="1" Style="{StaticResource FaintCard}" VerticalAlignment="Top">
                    <StackPanel>
                        <TextBlock Text="DISPLAY" Style="{StaticResource Eyebrow}" Margin="0,0,0,6" />
                        <c:SettingRow Label="Grid columns" Description="Auto fits as many covers as the window allows.">
                            <c:SettingRow.Below>
                                <Border Background="{StaticResource SurfaceRaisedBrush}" CornerRadius="10" Padding="3" HorizontalAlignment="Left">
                                    <StackPanel Orientation="Horizontal">
                                        <RadioButton Content="Auto" GroupName="LibCols" Style="{StaticResource SegmentRadio}" IsChecked="True" />
                                        <RadioButton Content="5" GroupName="LibCols" Style="{StaticResource SegmentRadio}" />
                                        <RadioButton Content="6" GroupName="LibCols" Style="{StaticResource SegmentRadio}" />
                                        <RadioButton Content="7" GroupName="LibCols" Style="{StaticResource SegmentRadio}" />
                                        <RadioButton Content="8" GroupName="LibCols" Style="{StaticResource SegmentRadio}" />
                                    </StackPanel>
                                </Border>
                            </c:SettingRow.Below>
                        </c:SettingRow>
                        <c:SettingRow Label="Unread badges">
                            <ToggleButton Style="{StaticResource MdSwitch}" IsChecked="True" />
                        </c:SettingRow>
                        <c:SettingRow Label="Downloaded badges">
                            <ToggleButton Style="{StaticResource MdSwitch}" IsChecked="True" />
                        </c:SettingRow>
                        <c:SettingRow Label="Continue reading row" ShowDivider="False">
                            <ToggleButton Style="{StaticResource MdSwitch}" IsChecked="True" />
                        </c:SettingRow>
                    </StackPanel>
                </Border>

                <StackPanel Grid.Row="1" Grid.Column="1" Spacing="20">
                    <!-- Updates -->
                    <Border Style="{StaticResource FaintCard}">
                        <StackPanel>
                            <TextBlock Text="UPDATES" Style="{StaticResource Eyebrow}" Margin="0,0,0,6" />
                            <c:SettingRow Label="Check for new chapters">
                                <ComboBox SelectedIndex="2" MinWidth="150" CornerRadius="10">
                                    <ComboBoxItem Content="Manually" />
                                    <ComboBoxItem Content="Every 6 hours" />
                                    <ComboBoxItem Content="Every 12 hours" />
                                    <ComboBoxItem Content="Daily" />
                                    <ComboBoxItem Content="Weekly" />
                                </ComboBox>
                            </c:SettingRow>
                            <c:SettingRow Label="Only on unmetered networks">
                                <ToggleButton Style="{StaticResource MdSwitch}" IsChecked="True" />
                            </c:SettingRow>
                            <c:SettingRow Label="Skip completed series" ShowDivider="False">
                                <ToggleButton Style="{StaticResource MdSwitch}" IsChecked="True" />
                            </c:SettingRow>
                        </StackPanel>
                    </Border>

                    <!-- Migration -->
                    <Border Style="{StaticResource FaintCard}">
                        <StackPanel>
                            <TextBlock Text="MIGRATION" Style="{StaticResource Eyebrow}" Margin="0,0,0,6" />
                            <c:SettingRow Label="Migrate between sources" Description="Move manga to another source and keep your progress." ShowDivider="False">
                                <Button Content="Open" Style="{StaticResource SmallGhostButton}" Click="OnMigrate" />
                            </c:SettingRow>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</Page>
