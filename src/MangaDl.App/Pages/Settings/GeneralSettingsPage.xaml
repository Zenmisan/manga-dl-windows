<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="MangaDl.Pages.Settings.GeneralSettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:c="using:MangaDl.Controls"
    xmlns:s="using:MangaDl.Services"
    xmlns:h="using:MangaDl.Helpers"
    Background="Transparent">

    <ScrollViewer Style="{StaticResource PageScroller}">
        <StackPanel Spacing="20" Padding="0,0,0,40" MaxWidth="1040" HorizontalAlignment="Left">
            <StackPanel>
                <TextBlock Text="General" Style="{StaticResource SectionTitle}" />
                <TextBlock Text="Look, desktop behaviour and your manga-dl server." Style="{StaticResource Caption}" FontSize="13" Margin="0,4,0,0" />
            </StackPanel>

            <Grid ColumnSpacing="20" RowSpacing="20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Appearance -->
                <Border Style="{StaticResource FaintCard}" VerticalAlignment="Top">
                    <StackPanel>
                        <TextBlock Text="APPEARANCE" Style="{StaticResource Eyebrow}" Margin="0,0,0,6" />
                        <c:SettingRow Label="Theme" Description="manga-dl is designed dark-first.">
                            <c:SettingRow.Below>
                                <Border Background="{StaticResource SurfaceRaisedBrush}" CornerRadius="10" Padding="3" HorizontalAlignment="Left">
                                    <StackPanel Orientation="Horizontal">
                                        <RadioButton Content="Dark" GroupName="GenTheme" Style="{StaticResource SegmentRadio}" IsChecked="True" />
                                        <RadioButton Content="AMOLED" GroupName="GenTheme" Style="{StaticResource SegmentRadio}" />
                                        <RadioButton Content="System" GroupName="GenTheme" Style="{StaticResource SegmentRadio}" />
                                    </StackPanel>
                                </Border>
                            </c:SettingRow.Below>
                        </c:SettingRow>
                        <c:SettingRow Label="Accent colour" Description="Buttons, progress and highlights.">
                            <c:SettingRow.Below>
                                <ItemsRepeater ItemsSource="{x:Bind Accents}">
                                    <ItemsRepeater.Layout>
                                        <StackLayout Orientation="Horizontal" Spacing="10" />
                                    </ItemsRepeater.Layout>
                                    <ItemsRepeater.ItemTemplate>
                                        <DataTemplate x:DataType="s:Accent">
                                            <Button Width="40" Height="40" Padding="0" CornerRadius="20" Background="Transparent"
                                                    BorderBrush="{x:Bind h:X.Hex(Main)}" BorderThickness="0"
                                                    Tag="{x:Bind Name}" Click="OnAccent" ToolTipService.ToolTip="{x:Bind Name}"
                                                    AutomationProperties.Name="{x:Bind Name}">
                                                <Ellipse Width="30" Height="30" Fill="{x:Bind h:X.Hex(Main)}" />
                                            </Button>
                                        </DataTemplate>
                                    </ItemsRepeater.ItemTemplate>
                                </ItemsRepeater>
                            </c:SettingRow.Below>
                        </c:SettingRow>
                        <c:SettingRow Label="Ambilight" Description="Tint the reader and detail pages with the cover's colour." ShowDivider="False">
                            <ToggleButton Style="{StaticResource MdSwitch}" IsChecked="True" />
                        </c:SettingRow>
                    </StackPanel>
                </Border>

                <!-- Desktop -->
                <Border Grid.Column="1" Style="{StaticResource FaintCard}" VerticalAlignment="Top">
                    <StackPanel>
                        <TextBlock Text="DESKTOP" Style="{StaticResource Eyebrow}" Margin="0,0,0,6" />
                        <c:SettingRow Label="Launch on startup" Description="Start manga-dl when you sign in to Windows.">
                            <ToggleButton Style="{StaticResource MdSwitch}" />
                        </c:SettingRow>
                        <c:SettingRow Label="Keep running in tray" Description="Closing the window keeps downloads going.">
                            <ToggleButton Style="{StaticResource MdSwitch}" IsChecked="True" />
                        </c:SettingRow>
                        <c:SettingRow Label="System notifications" Description="New chapters and finished downloads.">
                            <ToggleButton Style="{StaticResource MdSwitch}" IsChecked="True" />
                        </c:SettingRow>
                        <c:SettingRow Label="Discord Rich Presence" Description="Show what you're reading on Discord." ShowDivider="False">
                            <ToggleButton Style="{StaticResource MdSwitch}" />
                        </c:SettingRow>
                    </StackPanel>
                </Border>

                <!-- Connection -->
                <Border Grid.Row="1" Style="{StaticResource FaintCard}" VerticalAlignment="Top">
                    <StackPanel Spacing="14">
                        <TextBlock Text="CONNECTION" Style="{StaticResource Eyebrow}" />
                        <StackPanel Spacing="6">
                            <TextBlock Text="Server URL" Style="{StaticResource FieldLabel}" />
                            <TextBox Style="{StaticResource MdTextBox}" Text="http://localhost:4567" AutomationProperties.Name="Server URL" />
                        </StackPanel>
                        <StackPanel Spacing="6">
                            <TextBlock Text="API key" Style="{StaticResource FieldLabel}" />
                            <PasswordBox Style="{StaticResource MdPasswordBox}" Password="placeholder-key" AutomationProperties.Name="API key" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <Button Content="Test connection" Style="{StaticResource GhostButton}" Click="OnTest" />
                            <StackPanel x:Name="TestResult" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" Visibility="Collapsed">
                                <c:MdIcon Kind="Check" Size="16" Foreground="{StaticResource SuccessTextBrush}" />
                                <TextBlock Text="Connected · [latency] ms" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource SuccessTextBrush}" />
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Behaviour -->
                <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource FaintCard}" VerticalAlignment="Top">
                    <StackPanel>
                        <TextBlock Text="BEHAVIOUR" Style="{StaticResource Eyebrow}" Margin="0,0,0,6" />
                        <c:SettingRow Label="Incognito mode" Description="Pause history and tracker sync while it's on.">
                            <ToggleButton Style="{StaticResource MdSwitch}" />
                        </c:SettingRow>
                        <c:SettingRow Label="Auto-download new chapters" Description="For manga in your library." ShowDivider="False">
                            <ToggleButton Style="{StaticResource MdSwitch}" IsChecked="True" />
                        </c:SettingRow>
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</Page>
