<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="MangaDl.Pages.LeaderboardPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:c="using:MangaDl.Controls"
    xmlns:m="using:MangaDl.Core.Community"
    xmlns:h="using:MangaDl.Helpers"
    Background="{StaticResource BgBrush}">

    <ScrollViewer Style="{StaticResource PageScroller}">
        <StackPanel Padding="40,28,40,40" Spacing="24">
            <!-- Header -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="4">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <c:MdIcon Kind="Trophy" Size="26" Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center" />
                        <TextBlock Text="HUNTER HALL OF FAME" Style="{StaticResource PageTitle}" VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock Text="Top readers ranked by reading EXP, daily streaks, and Hunter Rank tier."
                               Style="{StaticResource Caption}" FontSize="14" />
                </StackPanel>

                <!-- Timeframe segment filter -->
                <Border Grid.Column="1" Background="{StaticResource SurfaceRaisedBrush}" CornerRadius="10" Padding="3" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <RadioButton x:Name="AllTimeOption" Content="All-Time" GroupName="LeaderboardTimeframe" Style="{StaticResource SegmentRadio}" IsChecked="True" Checked="OnTimeframeChecked" />
                        <RadioButton x:Name="MonthlyOption" Content="Monthly" GroupName="LeaderboardTimeframe" Style="{StaticResource SegmentRadio}" Checked="OnTimeframeChecked" />
                        <RadioButton x:Name="WeeklyOption" Content="Weekly" GroupName="LeaderboardTimeframe" Style="{StaticResource SegmentRadio}" Checked="OnTimeframeChecked" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- User Standing Hero Banner -->
            <Border x:Name="UserStandingCard" CornerRadius="16" Background="#FF1E293B" BorderBrush="#FF38BDF8" BorderThickness="1" Padding="20">
                <Grid ColumnSpacing="20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Border Width="56" Height="56" CornerRadius="28" Background="{StaticResource DarkChipBrush}" VerticalAlignment="Center">
                        <TextBlock x:Name="UserAvatarInitial" Text="U" FontSize="24" FontWeight="Bold" Foreground="{StaticResource FgBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>

                    <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <TextBlock x:Name="UserStandingName" Text="Your Standing" FontSize="18" FontWeight="Bold" Foreground="{StaticResource FgBrush}" />
                            <Border x:Name="UserRankBadge" CornerRadius="6" Background="#FF38BDF8" Padding="8,2" VerticalAlignment="Center">
                                <TextBlock x:Name="UserRankText" Text="E-Rank Novice" FontSize="11" FontWeight="Bold" Foreground="#FF000000" />
                            </Border>
                        </StackPanel>
                        <TextBlock x:Name="UserStatsSubtitle" Text="Loading standing..." FontSize="13" Foreground="{StaticResource FgSoftBrush}" />
                    </StackPanel>

                    <StackPanel Grid.Column="2" Spacing="2" VerticalAlignment="Center" HorizontalAlignment="Right">
                        <TextBlock Text="RANK POSITION" FontSize="11" FontWeight="Bold" Foreground="{StaticResource FgSubtleBrush}" HorizontalAlignment="Right" />
                        <TextBlock x:Name="UserPlacementText" Text="#--" FontSize="32" FontWeight="Black" Foreground="{StaticResource AccentLightBrush}" HorizontalAlignment="Right" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Top 3 Hunter Podium -->
            <StackPanel Spacing="12">
                <TextBlock Text="TOP 3 HUNTERS" Style="{StaticResource EyebrowMuted}" />
                <Grid x:Name="PodiumGrid" ColumnSpacing="16" Height="220">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- #2 Silver Podium (Left) -->
                    <Border Grid.Column="0" x:Name="PodiumSecond" CornerRadius="12" Background="{StaticResource SurfaceBrush}"
                            BorderBrush="#FF94A3B8" BorderThickness="1" VerticalAlignment="Bottom" Height="185">
                        <StackPanel Padding="16" Spacing="6" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Border Width="32" Height="32" CornerRadius="16" Background="#FF94A3B8" HorizontalAlignment="Center">
                                <TextBlock Text="2" FontSize="16" FontWeight="Black" Foreground="#FF000000" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock x:Name="Podium2Name" Text="Hunter #2" FontWeight="Bold" FontSize="14" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" />
                            <TextBlock x:Name="Podium2Rank" Text="S-Rank Hunter" FontSize="11" Foreground="#FF94A3B8" HorizontalAlignment="Center" />
                            <TextBlock x:Name="Podium2Score" Text="0 EXP" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource AccentLightBrush}" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Border>

                    <!-- #1 Gold Podium (Center, Tallest) -->
                    <Border Grid.Column="1" x:Name="PodiumFirst" CornerRadius="14" Background="{StaticResource SurfaceRaisedBrush}"
                            BorderBrush="#FFF59E0B" BorderThickness="2" VerticalAlignment="Bottom" Height="220">
                        <StackPanel Padding="16" Spacing="8" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Border Width="40" Height="40" CornerRadius="20" Background="#FFF59E0B" HorizontalAlignment="Center">
                                <TextBlock Text="1" FontSize="20" FontWeight="Black" Foreground="#FF000000" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock x:Name="Podium1Name" Text="Hunter #1" FontWeight="Bold" FontSize="16" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" />
                            <TextBlock x:Name="Podium1Rank" Text="Shadow Monarch" FontSize="12" FontWeight="Bold" Foreground="#FFC084FC" HorizontalAlignment="Center" />
                            <TextBlock x:Name="Podium1Score" Text="0 EXP" FontSize="15" FontWeight="Bold" Foreground="#FFF59E0B" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Border>

                    <!-- #3 Bronze Podium (Right) -->
                    <Border Grid.Column="2" x:Name="PodiumThird" CornerRadius="12" Background="{StaticResource SurfaceBrush}"
                            BorderBrush="#FFCD7F32" BorderThickness="1" VerticalAlignment="Bottom" Height="165">
                        <StackPanel Padding="16" Spacing="6" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Border Width="30" Height="30" CornerRadius="15" Background="#FFCD7F32" HorizontalAlignment="Center">
                                <TextBlock Text="3" FontSize="15" FontWeight="Black" Foreground="#FF000000" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock x:Name="Podium3Name" Text="Hunter #3" FontWeight="Bold" FontSize="14" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" />
                            <TextBlock x:Name="Podium3Rank" Text="A-Rank Hunter" FontSize="11" Foreground="#FFCD7F32" HorizontalAlignment="Center" />
                            <TextBlock x:Name="Podium3Score" Text="0 EXP" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource AccentLightBrush}" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Border>
                </Grid>
            </StackPanel>

            <!-- Leaderboard Table (#4+) -->
            <StackPanel Spacing="10">
                <TextBlock Text="RANKED HUNTERS" Style="{StaticResource EyebrowMuted}" />

                <!-- Table Header -->
                <Grid Padding="16,8" ColumnSpacing="16" BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,0,0,1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="48" />
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="*" MinWidth="110" />
                        <ColumnDefinition Width="80" />
                        <ColumnDefinition Width="80" />
                        <ColumnDefinition Width="100" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="RANK" Style="{StaticResource TableHeader}" />
                    <TextBlock Grid.Column="1" Text="HUNTER" Style="{StaticResource TableHeader}" />
                    <TextBlock Grid.Column="2" Text="TIER" Style="{StaticResource TableHeader}" />
                    <TextBlock Grid.Column="3" Text="STREAK" Style="{StaticResource TableHeader}" />
                    <TextBlock Grid.Column="4" Text="CHAPTERS" Style="{StaticResource TableHeader}" />
                    <TextBlock Grid.Column="5" Text="SCORE" Style="{StaticResource TableHeader}" HorizontalAlignment="Right" />
                </Grid>

                <!-- Table Body -->
                <StackPanel x:Name="RankedListPanel" Spacing="4" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
