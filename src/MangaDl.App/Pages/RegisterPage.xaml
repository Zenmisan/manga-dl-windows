<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="MangaDl.Pages.RegisterPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{StaticResource BgBrush}">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Grid Padding="64,72" Background="{StaticResource BloomBottomLeftBrush}" BorderBrush="{StaticResource DividerStrongBrush}" BorderThickness="0,0,1,0">
            <StackPanel VerticalAlignment="Bottom" Spacing="16">
                <TextBlock Text="STEP 3 OF 3" Style="{StaticResource Eyebrow}" />
                <TextBlock Text="CREATE ACCOUNT" Style="{StaticResource DisplayText}" FontSize="120" LineHeight="108" />
                <TextBlock Text="Free. Keeps your library, history and backups in sync across devices."
                           Style="{StaticResource BodyMuted}" FontSize="17" LineHeight="26" MaxWidth="440" HorizontalAlignment="Left" />
            </StackPanel>
        </Grid>

        <StackPanel Grid.Column="1" Padding="96,72" MaxWidth="612" HorizontalAlignment="Left" VerticalAlignment="Center" Spacing="14">
                <StackPanel>
                    <TextBlock Text="Username" Style="{StaticResource FieldLabel}" />
                    <TextBox x:Name="UsernameBox" Text="" Style="{StaticResource MdTextBox}" AutomationProperties.Name="Username" />
                </StackPanel>
                <StackPanel>
                    <TextBlock Text="Email" Style="{StaticResource FieldLabel}" />
                    <TextBox x:Name="EmailBox" PlaceholderText="you@example.com" Style="{StaticResource MdTextBox}" InputScope="EmailSmtpAddress" AutomationProperties.Name="Email" />
                </StackPanel>
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Password" Style="{StaticResource FieldLabel}" />
                        <PasswordBox x:Name="Password" Password="password1" Style="{StaticResource MdPasswordBox}" PasswordChanged="OnPasswordChanged" AutomationProperties.Name="Password" />
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="Confirm" Style="{StaticResource FieldLabel}" />
                        <PasswordBox x:Name="Confirm" Password="password1" Style="{StaticResource MdPasswordBox}" PasswordChanged="OnPasswordChanged" AutomationProperties.Name="Confirm password" />
                    </StackPanel>
                </Grid>
                <StackPanel Spacing="6">
                    <Grid ColumnSpacing="4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border x:Name="Strength1" Height="4" CornerRadius="2" Background="{StaticResource SuccessBrush}" />
                        <Border x:Name="Strength2" Grid.Column="1" Height="4" CornerRadius="2" Background="{StaticResource SuccessBrush}" />
                        <Border x:Name="Strength3" Grid.Column="2" Height="4" CornerRadius="2" Background="{StaticResource SuccessBrush}" />
                        <Border x:Name="Strength4" Grid.Column="3" Height="4" CornerRadius="2" Background="{StaticResource LineBrush}" />
                    </Grid>
                    <TextBlock x:Name="StrengthText" Text="Strong password · passwords match" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource SuccessTextBrush}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <CheckBox x:Name="Terms" Content="I agree to the" IsChecked="True" Style="{StaticResource MdCheckBox}" FontSize="13" Checked="OnTermsChanged" Unchecked="OnTermsChanged" />
                    <Button Content="Terms" Style="{StaticResource LinkButton}" FontSize="13" Margin="-6,0,0,0" Click="OnTermsClick" />
                </StackPanel>
                <TextBlock x:Name="ErrorText" Style="{StaticResource Body}" Foreground="{StaticResource ErrorTextBrush}" TextWrapping="Wrap" Visibility="Collapsed" />
                <Button x:Name="CreateButton" Content="Create Account" Style="{StaticResource PrimaryButtonLarge}" HorizontalAlignment="Stretch" Click="OnCreate" />
                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                    <TextBlock Text="Have an account?" Style="{StaticResource BodyMuted}" VerticalAlignment="Center" />
                    <Button Content="Sign in" Style="{StaticResource LinkButton}" Click="OnSignIn" />
                </StackPanel>
        </StackPanel>
    </Grid>
</Page>
