<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="MangaDl.Pages.HistoryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:c="using:MangaDl.Controls"
    xmlns:m="using:MangaDl.Core"
    xmlns:h="using:MangaDl.Helpers"
    Background="{StaticResource BgBrush}">

    <Page.Resources>
        <DataTemplate x:Key="HistoryCard" x:DataType="m:HistoryItem">
            <Border Style="{StaticResource ListCard}" Background="{StaticResource Surface4Brush}">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Width="56" Height="84" CornerRadius="8" Background="{x:Bind h:X.Hex(Manga.Cover)}" />
                    <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                        <TextBlock Text="{x:Bind Manga.Title}" Style="{StaticResource ItemTitle}" />
                        <TextBlock Text="{x:Bind Where}" FontSize="13" Foreground="{StaticResource FgSoftBrush}" />
                        <TextBlock Text="{x:Bind When}" FontSize="12" Foreground="{StaticResource FgFaintBrush}" />
                    </StackPanel>
                    <Button Grid.Column="2" Style="{StaticResource IconButton}" Width="40" Height="40" Foreground="{StaticResource FgSubtleBrush}"
                            VerticalAlignment="Center" Click="OnDeleteItem" AutomationProperties.Name="Remove from history">
                        <c:MdIcon Kind="Close" Size="18" />
                    </Button>
                    <Button Grid.Column="3" Content="Resume" Style="{StaticResource PrimaryButton}" Height="40" CornerRadius="10" Padding="16,0"
                            VerticalAlignment="Center" Click="OnResume" />
                </Grid>
            </Border>
        </DataTemplate>
    </Page.Resources>

    <ScrollViewer Style="{StaticResource PageScroller}">
        <StackPanel Padding="40,28,40,40" Spacing="18">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="HISTORY" Style="{StaticResource PageTitle}" VerticalAlignment="Center" />
                <c:SearchField Grid.Column="1" Width="300" Placeholder="Search history" VerticalAlignment="Center" Submitted="OnSearchSubmitted" />
                <Button Grid.Column="2" Content="Clear History" Style="{StaticResource DangerButton}" VerticalAlignment="Center" Click="OnClearHistory" />
            </Grid>

            <StackPanel Orientation="Horizontal" Spacing="8">
                <RadioButton Content="Today" GroupName="HistoryRange" Style="{StaticResource ChipRadio}" Checked="OnRangeChecked" />
                <RadioButton Content="This week" GroupName="HistoryRange" Style="{StaticResource ChipRadio}" IsChecked="True" Checked="OnRangeChecked" />
                <RadioButton Content="This month" GroupName="HistoryRange" Style="{StaticResource ChipRadio}" Checked="OnRangeChecked" />
                <RadioButton Content="All time" GroupName="HistoryRange" Style="{StaticResource ChipRadio}" Checked="OnRangeChecked" />
            </StackPanel>

            <ItemsRepeater ItemsSource="{x:Bind Items}" ItemTemplate="{StaticResource HistoryCard}">
                <ItemsRepeater.Layout>
                    <UniformGridLayout MinItemWidth="420" MinItemHeight="110" MinColumnSpacing="12" MinRowSpacing="12"
                                       MaximumRowsOrColumns="2" ItemsStretch="Fill" />
                </ItemsRepeater.Layout>
            </ItemsRepeater>
        </StackPanel>
    </ScrollViewer>
</Page>
