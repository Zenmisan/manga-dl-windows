<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="MangaDl.Pages.AllPagesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{StaticResource BgBrush}">

    <!-- Debug-only index of every screen, grouped like the desktop page on the design canvas. -->
    <Page.Resources>
        <Style x:Key="IndexLink" TargetType="Button" BasedOn="{StaticResource GhostButton}">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Height" Value="44" />
        </Style>
    </Page.Resources>

    <ScrollViewer Style="{StaticResource PageScroller}">
        <StackPanel Padding="40,28,40,40" Spacing="22" MaxWidth="1100" HorizontalAlignment="Left">
            <StackPanel>
                <TextBlock Text="ALL PAGES" Style="{StaticResource PageTitle}" />
                <TextBlock Text="Debug builds only. Jump to any screen to compare it with the design canvas." Style="{StaticResource Caption}" FontSize="14" Margin="0,4,0,0" />
            </StackPanel>

            <Grid ColumnSpacing="24" RowSpacing="24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Spacing="8">
                    <TextBlock Text="FIRST RUN" Style="{StaticResource Eyebrow}" />
                    <Button Content="Onboarding" Tag="Onboarding" Style="{StaticResource IndexLink}" Click="OnOpen" />
                    <Button Content="Sign in" Tag="Login" Style="{StaticResource IndexLink}" Click="OnOpen" />
                    <Button Content="Create account" Tag="Register" Style="{StaticResource IndexLink}" Click="OnOpen" />
                    <Button Content="Forgot password" Tag="Forgot" Style="{StaticResource IndexLink}" Click="OnOpen" />
                </StackPanel>

                <StackPanel Grid.Column="1" Spacing="8">
                    <TextBlock Text="MAIN" Style="{StaticResource Eyebrow}" />
                    <Button Content="Library" Tag="Library" Style="{StaticResource IndexLink}" Click="OnOpen" />
                    <Button Content="Updates" Tag="Updates" Style="{StaticResource IndexLink}" Click="OnOpen" />
                    <Button Content="History" Tag="History" Style="{StaticResource IndexLink}" Click="OnOpen" />
                    <Button Content="Notifications" Tag="Notifications" Style="{StaticResource IndexLink}" Click="OnOpen" />
                    <Button Content="Downloads" Tag="Downloads" Style="{StaticResource IndexLink}" Click="OnOpen" />
                    <Button Content="Statistics" Tag="Stats" Style="{StaticResource IndexLink}" Click="OnOpen" />
                </StackPanel>

                <StackPanel Grid.Column="2" Spacing="8">
                    <TextBlock Text="DISCOVER" Style="{StaticResource Eyebrow}" />
                    <Button Content="Browse · Extensions" Tag="Extensions" Style="{StaticResource IndexLink}" Click="OnOpen" />
                    <Button Content="Browse · Sources" Tag="Sources" Style="{StaticResource IndexLink}" Click="OnOpen" />
                    <Button Content="Browse · Migrate" Tag="Migrate" Style="{StaticResource IndexLink}" Click="OnOpen" />
                    <Button Content="Search" Tag="Search" Style="{StaticResource IndexLink}" Click="OnOpen" />
                    <Button Content="Browse a source" Tag="Source" Style="{StaticResource IndexLink}" Click="OnOpen" />
                    <Button Content="Import local files" Tag="Import" Style="{StaticResource IndexLink}" Click="OnOpen" />
                </StackPanel>

                <StackPanel Grid.Row="1" Spacing="8">
                    <TextBlock Text="READING &amp; YOU" Style="{StaticResource Eyebrow}" />
                    <Button Content="Manga detail" Tag="Detail" Style="{StaticResource IndexLink}" Click="OnOpen" />
                    <Button Content="Reader · two-page spread" Tag="Reader" Style="{StaticResource IndexLink}" Click="OnOpen" />
                    <Button Content="Reader · single page" Tag="ReaderSingle" Style="{StaticResource IndexLink}" Click="OnOpen" />
                    <Button Content="Novel reader" Tag="Novel" Style="{StaticResource IndexLink}" Click="OnOpen" />
                    <Button Content="Reader profile" Tag="Profile" Style="{StaticResource IndexLink}" Click="OnOpen" />
                    <Button Content="Help center" Tag="Help" Style="{StaticResource IndexLink}" Click="OnOpen" />
                </StackPanel>

                <StackPanel Grid.Row="1" Grid.Column="1" Spacing="8">
                    <TextBlock Text="SETTINGS" Style="{StaticResource Eyebrow}" />
                    <Button Content="Account" Tag="Set:Account" Style="{StaticResource IndexLink}" Click="OnOpen" />
                    <Button Content="General" Tag="Set:General" Style="{StaticResource IndexLink}" Click="OnOpen" />
                    <Button Content="Reader" Tag="Set:Reader" Style="{StaticResource IndexLink}" Click="OnOpen" />
                    <Button Content="Library" Tag="Set:Library" Style="{StaticResource IndexLink}" Click="OnOpen" />
                    <Button Content="Trackers" Tag="Set:Trackers" Style="{StaticResource IndexLink}" Click="OnOpen" />
                    <Button Content="System &amp; backup" Tag="Set:System" Style="{StaticResource IndexLink}" Click="OnOpen" />
                </StackPanel>

                <StackPanel Grid.Row="1" Grid.Column="2" Spacing="8">
                    <TextBlock Text="OVERLAYS" Style="{StaticResource Eyebrow}" />
                    <Button Content="App update available" Tag="Update" Style="{StaticResource IndexLink}" Click="OnOpen" />
                    <Button Content="Toast" Tag="Toast" Style="{StaticResource IndexLink}" Click="OnOpen" />
                </StackPanel>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</Page>
