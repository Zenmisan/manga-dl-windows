<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="MangaDl.Pages.MangaDetailPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:c="using:MangaDl.Controls"
    xmlns:m="using:MangaDl.Core"
    xmlns:h="using:MangaDl.Helpers"
    Background="{StaticResource BgBrush}">

    <Page.Resources>
        <DataTemplate x:Key="ChapterRow" x:DataType="m:Chapter">
            <Button Style="{StaticResource CardButton}" CornerRadius="0" Click="OnOpenChapter"
                    AutomationProperties.Name="{x:Bind Number}">
                <Grid MinHeight="48" Padding="12,0" ColumnSpacing="16" Opacity="{x:Bind h:X.ReadOpacity(Read)}"
                      BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,1,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="90" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="160" />
                        <ColumnDefinition Width="160" />
                        <ColumnDefinition Width="120" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{x:Bind Number}" FontWeight="Bold" Foreground="{StaticResource FgBrush}" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Text="{x:Bind Title}" Foreground="{StaticResource FgBrush}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="2" Text="{x:Bind Released}" Foreground="{StaticResource FgSubtleBrush}" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="3" Text="{x:Bind Group}" Foreground="{StaticResource FgSubtleBrush}" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="4" Text="{x:Bind Status}" FontSize="12" FontWeight="Bold" HorizontalAlignment="Right"
                               Foreground="{x:Bind h:X.ChapterStatus(Status)}" VerticalAlignment="Center" />
                </Grid>
            </Button>
        </DataTemplate>
    </Page.Resources>

    <ScrollViewer Style="{StaticResource PageScroller}">
        <StackPanel>
            <!-- Hero band, tinted with the cover colour (ambilight) -->
            <Grid x:Name="Hero" Padding="40,24,40,28" ColumnSpacing="32">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border x:Name="Cover" Width="200" Height="300" CornerRadius="14" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" />
                <StackPanel Grid.Column="1" Spacing="12" VerticalAlignment="Bottom">
                    <Button Content="Library" Style="{StaticResource LinkButton}" Foreground="{StaticResource FgSoftBrush}" FontWeight="SemiBold" HorizontalAlignment="Left" Padding="0,4" Click="OnBack" />
                    <TextBlock x:Name="TitleText" Style="{StaticResource DisplayText}" FontSize="64" LineHeight="64" />
                    <TextBlock x:Name="MetaText" FontSize="14" Foreground="{StaticResource FgStrongBrush}" />
                    <TextBlock Text="[Synopsis — pulled from the source. Shows up to four lines on desktop with a Show more link when it runs longer.]"
                               Style="{StaticResource Body}" Foreground="{StaticResource FgStrongBrush}" LineHeight="22" MaxWidth="680" HorizontalAlignment="Left"
                               MaxLines="4" TextTrimming="WordEllipsis" />
                    <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,6,0,0">
                        <Button Style="{StaticResource PrimaryButton}" Height="46" FontSize="14" Padding="22,0" Click="OnResume">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <c:MdIcon Kind="Play" Size="16" Foreground="{StaticResource WhiteBrush}" />
                                <TextBlock Text="Resume Ch. 48" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="InLibrary" Content="In Library" Style="{StaticResource GhostButton}" Background="{StaticResource DarkChipBrush}" BorderThickness="0" Height="46" FontSize="14" Click="OnLibraryToggled" />
                        <Button Content="Track" Style="{StaticResource GhostButton}" Background="{StaticResource DarkChipBrush}" BorderThickness="0" Height="46" FontSize="14" />
                        <Button Content="Download" Style="{StaticResource GhostButton}" Background="{StaticResource DarkChipBrush}" BorderThickness="0" Height="46" FontSize="14" Click="OnDownload" />
                        <Button Content="Migrate" Style="{StaticResource GhostButton}" Background="{StaticResource DarkChipBrush}" BorderThickness="0" Height="46" FontSize="14" Click="OnMigrate" />
                    </StackPanel>
                </StackPanel>
            </Grid>

            <!-- Chapter filters -->
            <Grid Padding="40,20,40,0" ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="96 chapters" Style="{StaticResource SectionTitle}" VerticalAlignment="Center" />
                <ToggleButton Grid.Column="1" Content="Unread" Style="{StaticResource SmallChipToggle}" />
                <ToggleButton Grid.Column="2" Content="Downloaded" Style="{StaticResource SmallChipToggle}" />
                <Button Grid.Column="3" Content="Newest first" Style="{StaticResource PillButton}" />
            </Grid>

            <!-- Chapter table -->
            <StackPanel Padding="40,12,40,40">
                <Grid Padding="12,8" ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="90" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="160" />
                        <ColumnDefinition Width="160" />
                        <ColumnDefinition Width="120" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="NO." Style="{StaticResource TableHeader}" />
                    <TextBlock Grid.Column="1" Text="TITLE" Style="{StaticResource TableHeader}" />
                    <TextBlock Grid.Column="2" Text="RELEASED" Style="{StaticResource TableHeader}" />
                    <TextBlock Grid.Column="3" Text="GROUP" Style="{StaticResource TableHeader}" />
                    <TextBlock Grid.Column="4" Text="STATUS" Style="{StaticResource TableHeader}" HorizontalAlignment="Right" />
                </Grid>
                <ItemsRepeater ItemsSource="{x:Bind Chapters}" ItemTemplate="{StaticResource ChapterRow}" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
