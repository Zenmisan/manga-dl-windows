<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="MangaDl.Pages.MangaDetailPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:c="using:MangaDl.Controls"
    xmlns:m="using:MangaDl.Core"
    xmlns:h="using:MangaDl.Helpers"
    Background="{StaticResource BgBrush}">

    <Page.Resources>
        <DataTemplate x:Key="ChapterRow" x:DataType="m:Chapter">
            <Button Style="{StaticResource CardButton}" CornerRadius="0" Click="OnOpenChapter"
                    AutomationProperties.Name="{x:Bind Number}">
                <Button.ContextFlyout>
                    <MenuFlyout>
                        <MenuFlyoutItem Text="Mark as Read" Click="OnMarkReadClicked">
                            <MenuFlyoutItem.Icon>
                                <FontIcon Glyph="&#xE73E;" />
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutItem Text="Mark as Unread" Click="OnMarkUnreadClicked">
                            <MenuFlyoutItem.Icon>
                                <FontIcon Glyph="&#xE73A;" />
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutItem Text="Mark Previous as Read" Click="OnMarkPreviousReadClicked">
                            <MenuFlyoutItem.Icon>
                                <FontIcon Glyph="&#xE8B7;" />
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutSeparator />
                        <MenuFlyoutItem Text="{x:Bind h:X.BookmarkMenuText(Bookmarked)}" Click="OnBookmarkChapterClicked">
                            <MenuFlyoutItem.Icon>
                                <FontIcon Glyph="&#xE734;" />
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutItem Text="Download Chapter" Click="OnDownloadChapterClicked">
                            <MenuFlyoutItem.Icon>
                                <FontIcon Glyph="&#xE896;" />
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                    </MenuFlyout>
                </Button.ContextFlyout>
                <Grid MinHeight="48" Padding="12,0" ColumnSpacing="16" Opacity="{x:Bind h:X.ReadOpacity(Read)}"
                      BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,1,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="72" />
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="*" MinWidth="80" MaxWidth="140" />
                        <ColumnDefinition Width="*" MinWidth="80" MaxWidth="140" />
                        <ColumnDefinition Width="84" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <TextBlock Text="{x:Bind Number}" FontWeight="Bold" Foreground="{StaticResource FgBrush}" VerticalAlignment="Center" />
                        <c:MdIcon Kind="BookmarkFilled" Size="12" Foreground="{StaticResource BookmarkGoldBrush}"
                                  Visibility="{x:Bind h:X.BookmarkVisibility(Bookmarked)}" VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock Grid.Column="1" Text="{x:Bind Title}" Foreground="{StaticResource FgBrush}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="2" Text="{x:Bind Released}" Foreground="{StaticResource FgSubtleBrush}" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="3" Text="{x:Bind Group}" Foreground="{StaticResource FgSubtleBrush}" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="4" Text="{x:Bind Status}" FontSize="12" FontWeight="Bold" HorizontalAlignment="Right"
                               Foreground="{x:Bind h:X.ChapterStatus(Status)}" VerticalAlignment="Center" />
                </Grid>
            </Button>
        </DataTemplate>
    </Page.Resources>

    <ScrollViewer Style="{StaticResource PageScroller}">
        <StackPanel>
            <!-- Hero band, tinted with the cover colour (ambilight) -->
            <Grid x:Name="Hero" Padding="40,24,40,28" ColumnSpacing="32">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border x:Name="Cover" Width="200" Height="300" CornerRadius="14" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" />
                <StackPanel Grid.Column="1" Spacing="12" VerticalAlignment="Bottom">
                    <Button Content="Library" Style="{StaticResource LinkButton}" Foreground="{StaticResource FgSoftBrush}" FontWeight="SemiBold" HorizontalAlignment="Left" Padding="0,4" Click="OnBack" />
                    <TextBlock x:Name="TitleText" Style="{StaticResource DisplayText}" FontSize="42" LineHeight="46" TextWrapping="Wrap" MaxLines="3" />
                    <TextBlock x:Name="MetaText" FontSize="14" Foreground="{StaticResource FgStrongBrush}" TextWrapping="Wrap" />
                    <TextBlock x:Name="SynopsisText" Text="Loading synopsis..."
                               Style="{StaticResource Body}" Foreground="{StaticResource FgStrongBrush}" LineHeight="22" MaxWidth="680" HorizontalAlignment="Left"
                               MaxLines="4" TextTrimming="WordEllipsis" />
                    <Grid Margin="0,6,0,0" RowSpacing="8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <!-- Primary reading and library actions -->
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Button Style="{StaticResource PrimaryButton}" Height="44" FontSize="14" Padding="20,0" Click="OnResume">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <c:MdIcon Kind="Play" Size="16" Foreground="{StaticResource WhiteBrush}" />
                                    <TextBlock x:Name="ResumeText" Text="Start Reading" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="InLibrary" Content="In Library" Style="{StaticResource GhostButton}" Background="{StaticResource DarkChipBrush}" BorderThickness="0" Height="44" FontSize="13" Click="OnLibraryToggled" />
                            <Button x:Name="CategoriesButton" Content="Categories" Style="{StaticResource GhostButton}" Background="{StaticResource DarkChipBrush}" BorderThickness="0" Height="44" FontSize="13" Click="OnCategoriesClicked" />
                        </StackPanel>
                        <!-- Secondary actions -->
                        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="10">
                            <Button Content="Track" Style="{StaticResource GhostButton}" Background="{StaticResource DarkChipBrush}" BorderThickness="0" Height="38" FontSize="13" Click="OnTrack" />
                            <Button Content="Download" Style="{StaticResource GhostButton}" Background="{StaticResource DarkChipBrush}" BorderThickness="0" Height="38" FontSize="13" Click="OnDownload" />
                            <Button Content="Migrate" Style="{StaticResource GhostButton}" Background="{StaticResource DarkChipBrush}" BorderThickness="0" Height="38" FontSize="13" Click="OnMigrate" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Grid>

            <!-- Chapter filters -->
            <Grid Padding="40,20,40,0" ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="ChapterCountText" Text="Chapters" Style="{StaticResource SectionTitle}" VerticalAlignment="Center" />
                <ComboBox x:Name="GroupFilterComboBox" Grid.Column="1" PlaceholderText="All Groups"
                          MinWidth="130" Height="32" FontSize="12" VerticalAlignment="Center"
                          SelectionChanged="OnGroupFilterChanged" />
                <ToggleButton x:Name="FilterUnread" Grid.Column="2" Content="Unread" Style="{StaticResource SmallChipToggle}" Click="OnFilterChanged" />
                <ToggleButton x:Name="FilterDownloaded" Grid.Column="3" Content="Downloaded" Style="{StaticResource SmallChipToggle}" Click="OnFilterChanged" />
                <ToggleButton x:Name="FilterBookmarked" Grid.Column="4" Content="Bookmarked" Style="{StaticResource SmallChipToggle}" Click="OnFilterChanged" />
                <Button x:Name="SortChaptersButton" Grid.Column="5" Content="Newest first" Style="{StaticResource PillButton}" Click="OnSortChapters" />
            </Grid>

            <!-- Chapter table -->
            <StackPanel Padding="40,12,40,40">
                <Grid Padding="12,8" ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="64" />
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="*" MinWidth="80" MaxWidth="140" />
                        <ColumnDefinition Width="*" MinWidth="80" MaxWidth="140" />
                        <ColumnDefinition Width="84" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="NO." Style="{StaticResource TableHeader}" />
                    <TextBlock Grid.Column="1" Text="TITLE" Style="{StaticResource TableHeader}" />
                    <TextBlock Grid.Column="2" Text="RELEASED" Style="{StaticResource TableHeader}" />
                    <TextBlock Grid.Column="3" Text="GROUP" Style="{StaticResource TableHeader}" />
                    <TextBlock Grid.Column="4" Text="STATUS" Style="{StaticResource TableHeader}" HorizontalAlignment="Right" />
                </Grid>
                <ItemsRepeater ItemsSource="{x:Bind Chapters}" ItemTemplate="{StaticResource ChapterRow}" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
