<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="MangaDl.Pages.ReaderPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:c="using:MangaDl.Controls"
    Background="{StaticResource ReaderBgBrush}"
    KeyDown="OnKeyDown">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="56" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ===== Top bar ===== -->
        <Grid Background="#EB080808" BorderBrush="{StaticResource DividerStrongBrush}" BorderThickness="0,0,0,1" Padding="16,0" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Button Style="{StaticResource IconButton}" Click="OnClose" AutomationProperties.Name="Close reader">
                <c:MdIcon Kind="Back" Size="20" />
            </Button>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Spacing="8">
                <TextBlock x:Name="ReaderMangaTitle" Text="Manga Title" FontSize="14" FontWeight="Bold" Foreground="{StaticResource FgBrush}" VerticalAlignment="Center" MaxWidth="220" TextTrimming="CharacterEllipsis" />
                <ComboBox x:Name="ChapterDropdown" MinWidth="130" MaxWidth="220" Height="32" CornerRadius="8"
                          Background="{StaticResource SurfaceRaisedBrush}" FontSize="12" VerticalAlignment="Center"
                          SelectionChanged="OnChapterDropdownChanged" AutomationProperties.Name="Select chapter" />
                <TextBlock x:Name="ReaderChapterTitle" Text="" Visibility="Collapsed" />
            </StackPanel>

            <Border Grid.Column="2" Background="{StaticResource SurfaceRaisedBrush}" CornerRadius="10" Padding="3" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Spacing="4">
                    <RadioButton x:Name="SingleOption" Content="Single" GroupName="ReaderLayout" Style="{StaticResource SegmentRadio}" Checked="OnLayoutChecked" />
                    <RadioButton x:Name="SpreadOption" Content="Spread" GroupName="ReaderLayout" Style="{StaticResource SegmentRadio}" IsChecked="True" Checked="OnLayoutChecked" />
                    <RadioButton x:Name="WebtoonOption" Content="Webtoon" GroupName="ReaderLayout" Style="{StaticResource SegmentRadio}" Checked="OnLayoutChecked" />
                </StackPanel>
            </Border>

            <Button Grid.Column="3" Content="Prev ch." Style="{StaticResource SmallGhostButton}" FontWeight="Bold" Click="OnPrevChapter" />
            <TextBlock x:Name="PageCount" Grid.Column="4" Text="1 / 1" MinWidth="72" TextAlignment="Center" FontSize="13" FontWeight="Bold"
                       Foreground="{StaticResource FgBrush}" VerticalAlignment="Center" AutomationProperties.LiveSetting="Polite" />
            <Button Grid.Column="5" Content="Next ch." Style="{StaticResource SmallGhostButton}" FontWeight="Bold" Click="OnNextChapter" />

            <Button Grid.Column="6" Style="{StaticResource IconButton}" Click="OnBookmark" AutomationProperties.Name="Bookmark page">
                <c:MdIcon x:Name="BookmarkIcon" Kind="Bookmark" Size="20" />
            </Button>
            <ToggleButton x:Name="CommentsToggle" Grid.Column="7" Style="{StaticResource IconToggle}"
                          Checked="OnCommentsToggled" Unchecked="OnCommentsToggled" AutomationProperties.Name="Chapter comments">
                <c:MdIcon Kind="Chat" Size="20" />
            </ToggleButton>
            <Button Grid.Column="8" Style="{StaticResource IconButton}" Click="OnFullscreen" AutomationProperties.Name="Toggle fullscreen">
                <c:MdIcon Kind="Fullscreen" Size="20" />
            </Button>
            <ToggleButton x:Name="SettingsToggle" Grid.Column="9" Style="{StaticResource IconToggle}" IsChecked="True"
                          Checked="OnSettingsToggled" Unchecked="OnSettingsToggled" AutomationProperties.Name="Reader settings">
                <c:MdIcon Kind="Sliders" Size="20" />
            </ToggleButton>
        </Grid>

        <!-- ===== Stage + settings panel ===== -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Two-page spread -->
            <Viewbox x:Name="SpreadView" Margin="20" Stretch="Uniform" StretchDirection="DownOnly">
                <StackPanel Orientation="Horizontal" Spacing="4">
                    <Grid>
                        <Border x:Name="LeftGlowBorder" CornerRadius="8" Margin="-12" Opacity="0" Background="{StaticResource AccentBrush}" />
                        <Border x:Name="LeftPageBorder" Background="#141414" CornerRadius="4" Width="520" Height="760">
                            <Grid>
                                <Image x:Name="LeftImage" Stretch="Uniform" />
                                <Border x:Name="LeftSepiaOverlay" Background="#9A6A38" Opacity="0" IsHitTestVisible="False" />
                                <Border x:Name="LeftDimOverlay" Background="Black" Opacity="0" IsHitTestVisible="False" />
                                <Border x:Name="LeftBrightOverlay" Background="White" Opacity="0" IsHitTestVisible="False" />
                            </Grid>
                        </Border>
                    </Grid>
                    <Grid>
                        <Border x:Name="RightGlowBorder" CornerRadius="8" Margin="-12" Opacity="0" Background="{StaticResource AccentBrush}" />
                        <Border x:Name="RightPageBorder" Background="#141414" CornerRadius="4" Width="520" Height="760">
                            <Grid>
                                <Image x:Name="RightImage" Stretch="Uniform" />
                                <Border x:Name="RightSepiaOverlay" Background="#9A6A38" Opacity="0" IsHitTestVisible="False" />
                                <Border x:Name="RightDimOverlay" Background="Black" Opacity="0" IsHitTestVisible="False" />
                                <Border x:Name="RightBrightOverlay" Background="White" Opacity="0" IsHitTestVisible="False" />
                            </Grid>
                        </Border>
                    </Grid>
                </StackPanel>
            </Viewbox>

            <!-- Single page with side buttons -->
            <Grid x:Name="SingleView" Visibility="Collapsed">
                <Grid Padding="0,16,0,100">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="1" Style="{StaticResource IconButton}" Width="56" Height="96" CornerRadius="14" Margin="0,0,24,0"
                            Background="{StaticResource SurfaceBrush}" Foreground="{StaticResource FgSoftBrush}" Click="OnPrevPage" AutomationProperties.Name="Previous page">
                        <c:MdIcon Kind="Back" Size="24" />
                    </Button>
                    <Viewbox Grid.Column="2" Stretch="Uniform" StretchDirection="DownOnly">
                        <Grid>
                            <Border x:Name="SingleGlowBorder" CornerRadius="8" Margin="-12" Opacity="0" Background="{StaticResource AccentBrush}" />
                            <Border x:Name="SinglePageBorder" Background="#141414" CornerRadius="4" Width="520" Height="760">
                                <Grid>
                                    <Image x:Name="SingleImage" Stretch="Uniform" />
                                    <Border x:Name="SingleSepiaOverlay" Background="#9A6A38" Opacity="0" IsHitTestVisible="False" />
                                    <Border x:Name="SingleDimOverlay" Background="Black" Opacity="0" IsHitTestVisible="False" />
                                    <Border x:Name="SingleBrightOverlay" Background="White" Opacity="0" IsHitTestVisible="False" />
                                </Grid>
                            </Border>
                        </Grid>
                    </Viewbox>
                    <Button Grid.Column="3" Style="{StaticResource IconButton}" Width="56" Height="96" CornerRadius="14" Margin="24,0,0,0"
                            Background="{StaticResource SurfaceBrush}" Foreground="{StaticResource FgSoftBrush}" Click="OnNextPage" AutomationProperties.Name="Next page">
                        <c:MdIcon Kind="ChevronRight" Size="24" />
                    </Button>
                </Grid>
            </Grid>

            <!-- Webtoon / Continuous vertical strip -->
            <ScrollViewer x:Name="WebtoonView" Visibility="Collapsed" Style="{StaticResource PageScroller}">
                <StackPanel x:Name="WebtoonPagesStack" HorizontalAlignment="Center" Spacing="4" Padding="0,20,0,40" />
            </ScrollViewer>

            <!-- Bottom Floating Controls: Filmstrip Scrubber + Slider Pill Bar -->
            <StackPanel x:Name="BottomControlsOverlay" Spacing="8" Margin="0,0,0,20" HorizontalAlignment="Center" VerticalAlignment="Bottom">
                <!-- Filmstrip Scrubber (chapters <= 60 pages) -->
                <Border x:Name="FilmstripContainer" Visibility="Collapsed" Padding="10,6" CornerRadius="14"
                        Background="#E60A0A0A" BorderBrush="{StaticResource DividerStrongBrush}" BorderThickness="1"
                        MaxWidth="840" Height="74">
                    <ScrollViewer x:Name="FilmstripScrollViewer" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled"
                                  HorizontalScrollMode="Enabled" VerticalScrollMode="Disabled">
                        <StackPanel x:Name="FilmstripThumbnailsStack" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" />
                    </ScrollViewer>
                </Border>

                <!-- Floating Pill Bar -->
                <Border Width="720" Padding="8" CornerRadius="999" Background="#F00E0E0E" BorderBrush="{StaticResource DividerStrongBrush}" BorderThickness="1">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Button Content="Prev Ch." Style="{StaticResource PillButton}" Height="40" CornerRadius="20" BorderThickness="0" Background="{StaticResource SurfaceHighBrush}" Click="OnPrevChapter" />
                        <TextBlock x:Name="SliderPage" Grid.Column="1" Text="1" MinWidth="24" TextAlignment="Center" FontSize="13" FontWeight="ExtraBold" Foreground="{StaticResource FgBrush}" VerticalAlignment="Center" />
                        <Slider x:Name="PageSlider" Grid.Column="2" Minimum="1" Maximum="38" Value="1" StepFrequency="1" VerticalAlignment="Center"
                                ValueChanged="OnSliderChanged" AutomationProperties.Name="Page" />
                        <TextBlock x:Name="SliderPageTotal" Grid.Column="3" Text="1" MinWidth="24" TextAlignment="Center" FontSize="13" FontWeight="Bold" Foreground="{StaticResource FgSubtleBrush}" VerticalAlignment="Center" />
                        <Button Content="Next Ch." Style="{StaticResource PillPrimaryButton}" Height="40" CornerRadius="20" Click="OnNextChapter" />
                    </Grid>
                </Border>
            </StackPanel>

            <!-- Loading indicator -->
            <ProgressRing x:Name="LoadingRing" IsActive="False" Visibility="Collapsed" Width="54" Height="54" HorizontalAlignment="Center" VerticalAlignment="Center" />

            <!-- ===== Settings panel ===== -->
            <Border x:Name="SettingsPanel" Grid.Column="1" Width="340" Background="{StaticResource PanelBrush}"
                    BorderBrush="{StaticResource DividerStrongBrush}" BorderThickness="1,0,0,0">
                <ScrollViewer Style="{StaticResource PageScroller}">
                    <StackPanel Padding="24" Spacing="24">
                        <TextBlock Text="READER" Style="{StaticResource DisplayText}" FontSize="24" />

                        <StackPanel Spacing="10">
                            <TextBlock Text="READING MODE" Style="{StaticResource EyebrowMuted}" />
                            <Grid ColumnSpacing="8" RowSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition />
                                    <RowDefinition />
                                </Grid.RowDefinitions>
                                <RadioButton Content="LTR pager" GroupName="ReadMode" Style="{StaticResource OptionRadio}" />
                                <RadioButton Grid.Column="1" Content="RTL pager" GroupName="ReadMode" Style="{StaticResource OptionRadio}" IsChecked="True" />
                                <RadioButton Grid.Row="1" Content="Webtoon" GroupName="ReadMode" Style="{StaticResource OptionRadio}" />
                                <RadioButton Grid.Row="1" Grid.Column="1" Content="Vertical" GroupName="ReadMode" Style="{StaticResource OptionRadio}" />
                            </Grid>
                        </StackPanel>

                        <StackPanel>
                            <Grid MinHeight="44">
                                <TextBlock Text="Dual-page spread" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource FgBrush}" VerticalAlignment="Center" />
                                <ToggleButton x:Name="DualToggle" Style="{StaticResource MdSwitch}" IsChecked="True" HorizontalAlignment="Right"
                                              Checked="OnDualToggled" Unchecked="OnDualToggled" AutomationProperties.Name="Dual-page spread" />
                            </Grid>
                            <Grid MinHeight="44">
                                <TextBlock Text="Page filmstrip scrubber" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource FgBrush}" VerticalAlignment="Center" />
                                <ToggleButton x:Name="FilmstripToggle" Style="{StaticResource MdSwitch}" IsChecked="True" HorizontalAlignment="Right"
                                              Checked="OnFilmstripToggled" Unchecked="OnFilmstripToggled" AutomationProperties.Name="Page filmstrip scrubber" />
                            </Grid>
                            <Grid MinHeight="44">
                                <TextBlock Text="Ambient Ambilight glow" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource FgBrush}" VerticalAlignment="Center" />
                                <ToggleButton x:Name="AmbilightToggle" Style="{StaticResource MdSwitch}" HorizontalAlignment="Right"
                                              Checked="OnAmbilightToggled" Unchecked="OnAmbilightToggled" AutomationProperties.Name="Ambient Ambilight glow" />
                            </Grid>
                            <Grid MinHeight="44">
                                <TextBlock Text="Crop borders" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource FgBrush}" VerticalAlignment="Center" />
                                <ToggleButton x:Name="DrawerCropBorders" Style="{StaticResource MdSwitch}" HorizontalAlignment="Right" AutomationProperties.Name="Crop borders" />
                            </Grid>
                            <Grid MinHeight="44">
                                <TextBlock Text="Tap zones" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource FgBrush}" VerticalAlignment="Center" />
                                <ToggleButton x:Name="DrawerTapZones" Style="{StaticResource MdSwitch}" IsChecked="True" HorizontalAlignment="Right" AutomationProperties.Name="Tap zones" />
                            </Grid>
                        </StackPanel>

                        <StackPanel Spacing="14">
                            <TextBlock Text="IMAGE FILTERS" Style="{StaticResource EyebrowMuted}" />
                            <StackPanel Spacing="4">
                                <Grid>
                                    <TextBlock Text="Brightness" FontSize="13" Foreground="{StaticResource FgBrush}" />
                                    <TextBlock x:Name="BrightnessText" Text="100%" FontSize="13" Foreground="{StaticResource FgSubtleBrush}" HorizontalAlignment="Right" />
                                </Grid>
                                <Slider x:Name="BrightnessSlider" Minimum="50" Maximum="150" Value="100" ValueChanged="OnBrightness" AutomationProperties.Name="Brightness" />
                            </StackPanel>
                            <StackPanel Spacing="4">
                                <Grid>
                                    <TextBlock Text="Contrast" FontSize="13" Foreground="{StaticResource FgBrush}" />
                                    <TextBlock x:Name="ContrastText" Text="100%" FontSize="13" Foreground="{StaticResource FgSubtleBrush}" HorizontalAlignment="Right" />
                                </Grid>
                                <Slider x:Name="ContrastSlider" Minimum="50" Maximum="150" Value="100" ValueChanged="OnContrast" AutomationProperties.Name="Contrast" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <ToggleButton x:Name="GrayscaleToggle" Content="Grayscale" Style="{StaticResource SmallChipToggle}"
                                              Checked="OnFilterChipToggled" Unchecked="OnFilterChipToggled" />
                                <ToggleButton x:Name="InvertToggle" Content="Invert" Style="{StaticResource SmallChipToggle}"
                                              Checked="OnFilterChipToggled" Unchecked="OnFilterChipToggled" />
                                <ToggleButton x:Name="SepiaToggle" Content="Sepia" Style="{StaticResource SmallChipToggle}"
                                              Checked="OnFilterChipToggled" Unchecked="OnFilterChipToggled" />
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- Comments drawer (340px) -->
            <Border x:Name="CommentsDrawer" Grid.Column="1" Width="340"
                    Background="{StaticResource PanelBrush}"
                    BorderBrush="{StaticResource DividerStrongBrush}"
                    BorderThickness="1,0,0,0"
                    Visibility="Collapsed">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Drawer Header -->
                    <Grid Padding="18,16" BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,0,0,1">
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <c:MdIcon Kind="Chat" Size="18" Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center" />
                            <TextBlock x:Name="DrawerCommentsTitle" Text="Chapter Comments" Style="{StaticResource SectionTitle}" FontSize="16" VerticalAlignment="Center" />
                        </StackPanel>
                        <Button Style="{StaticResource IconButton}" HorizontalAlignment="Right" Click="OnCloseCommentsDrawer" AutomationProperties.Name="Close comments">
                            <c:MdIcon Kind="Close" Size="16" />
                        </Button>
                    </Grid>

                    <!-- Comments List -->
                    <ScrollViewer Grid.Row="1" Padding="16,12">
                        <StackPanel x:Name="DrawerCommentsList" Spacing="10" />
                    </ScrollViewer>

                    <!-- Comment Composer -->
                    <Border Grid.Row="2" Padding="14" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,1,0,0">
                        <StackPanel Spacing="8">
                            <TextBox x:Name="DrawerCommentInput" PlaceholderText="Drop a comment on this chapter..."
                                     AcceptsReturn="True" TextWrapping="Wrap" MaxHeight="80" FontSize="12" />
                            <Grid>
                                <TextBlock x:Name="DrawerPostingAsText" Text="Hunter" FontSize="11" Foreground="{StaticResource FgSubtleBrush}" VerticalAlignment="Center" />
                                <Button Content="Post" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Right" Height="30" FontSize="11" Click="OnPostDrawerCommentClicked" />
                            </Grid>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Page>
