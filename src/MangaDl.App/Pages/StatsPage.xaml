<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="MangaDl.Pages.StatsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:c="using:MangaDl.Controls"
    xmlns:m="using:MangaDl.Core"
    xmlns:h="using:MangaDl.Helpers"
    xmlns:p="using:MangaDl.Pages"
    Background="{StaticResource BgBrush}">

    <Page.Resources>
        <DataTemplate x:Key="HeatCell" x:DataType="p:HeatDay">
            <Border Width="16" Height="16" CornerRadius="3" Background="{x:Bind h:X.Heat(Level)}" />
        </DataTemplate>

        <DataTemplate x:Key="BarRow" x:DataType="m:Bar">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="100" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{x:Bind Name}" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource FgBrush}" VerticalAlignment="Center" />
                <c:MdProgress Grid.Column="1" Value="{x:Bind Fraction}" Height="8" Fill="{StaticResource FgBrush}" Track="{StaticResource SurfaceHighBrush}" VerticalAlignment="Center" />
            </Grid>
        </DataTemplate>
    </Page.Resources>

    <ScrollViewer Style="{StaticResource PageScroller}">
        <StackPanel Padding="40,28,40,40" Spacing="22">
            <StackPanel>
                <TextBlock Text="STATISTICS" Style="{StaticResource PageTitle}" />
                <TextBlock Text="Your reading habits, at a glance" Style="{StaticResource Caption}" FontSize="14" Margin="0,4,0,0" />
            </StackPanel>

            <!-- Stat tiles -->
            <Grid ColumnSpacing="14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource Card}" Background="{StaticResource SurfaceBrush}" Padding="18">
                    <StackPanel Spacing="8">
                        <TextBlock Text="Chapters read" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource FgSubtleBrush}" />
                        <TextBlock Text="[n]" Style="{StaticResource DisplayText}" FontSize="40" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" Style="{StaticResource Card}" Background="{StaticResource SurfaceBrush}" Padding="18">
                    <StackPanel Spacing="8">
                        <TextBlock Text="Time reading" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource FgSubtleBrush}" />
                        <TextBlock Text="[h]" Style="{StaticResource DisplayText}" FontSize="40" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource Card}" Background="{StaticResource SurfaceBrush}" Padding="18">
                    <StackPanel Spacing="8">
                        <TextBlock Text="Current streak" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource FgSubtleBrush}" />
                        <TextBlock Text="[d]" Style="{StaticResource DisplayText}" FontSize="40" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="3" Style="{StaticResource Card}" Background="{StaticResource SurfaceBrush}" Padding="18">
                    <StackPanel Spacing="8">
                        <TextBlock Text="Reading pace" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource FgSubtleBrush}" />
                        <TextBlock Text="[n]/wk" Style="{StaticResource DisplayText}" FontSize="40" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- 52-week heatmap -->
            <Border Style="{StaticResource FaintCard}">
                <StackPanel Spacing="12">
                    <Grid>
                        <TextBlock Text="ACTIVITY · LAST 52 WEEKS" Style="{StaticResource Eyebrow}" />
                        <TextBlock Text="Chapters per day" Style="{StaticResource Caption}" HorizontalAlignment="Right" />
                    </Grid>
                    <ScrollViewer HorizontalScrollMode="Auto" HorizontalScrollBarVisibility="Auto" VerticalScrollMode="Disabled" VerticalScrollBarVisibility="Disabled">
                        <ItemsRepeater ItemsSource="{x:Bind Activity}" ItemTemplate="{StaticResource HeatCell}">
                            <ItemsRepeater.Layout>
                                <UniformGridLayout Orientation="Vertical" MaximumRowsOrColumns="7" MinItemWidth="16" MinItemHeight="16"
                                                   MinColumnSpacing="4" MinRowSpacing="4" />
                            </ItemsRepeater.Layout>
                        </ItemsRepeater>
                    </ScrollViewer>
                    <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Right">
                        <TextBlock Text="Less" Style="{StaticResource Caption}" FontSize="11" VerticalAlignment="Center" />
                        <Border Width="10" Height="10" CornerRadius="2" Background="{StaticResource Surface4Brush}" />
                        <Border Width="10" Height="10" CornerRadius="2" Background="#59DC2626" />
                        <Border Width="10" Height="10" CornerRadius="2" Background="#A6DC2626" />
                        <Border Width="10" Height="10" CornerRadius="2" Background="{StaticResource AccentBrush}" />
                        <TextBlock Text="More" Style="{StaticResource Caption}" FontSize="11" VerticalAlignment="Center" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Goals and breakdowns -->
            <Grid ColumnSpacing="14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Style="{StaticResource FaintCard}">
                    <StackPanel Spacing="14">
                        <TextBlock Text="READING GOALS" Style="{StaticResource EyebrowMuted}" />
                        <StackPanel Spacing="6">
                            <Grid>
                                <TextBlock Text="Monthly chapters" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource FgBrush}" />
                                <TextBlock Text="[x] / [goal]" FontSize="13" Foreground="{StaticResource FgSubtleBrush}" HorizontalAlignment="Right" />
                            </Grid>
                            <c:MdProgress Value="0.62" Height="6" />
                        </StackPanel>
                        <StackPanel Spacing="6">
                            <Grid>
                                <TextBlock Text="Yearly manga" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource FgBrush}" />
                                <TextBlock Text="[x] / [goal]" FontSize="13" Foreground="{StaticResource FgSubtleBrush}" HorizontalAlignment="Right" />
                            </Grid>
                            <c:MdProgress Value="0.35" Height="6" />
                        </StackPanel>
                        <Button Content="Edit Goals" Style="{StaticResource SmallGhostButton}" FontWeight="Bold" HorizontalAlignment="Left" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource FaintCard}">
                    <StackPanel Spacing="12">
                        <TextBlock Text="BY CATEGORY" Style="{StaticResource EyebrowMuted}" />
                        <ItemsRepeater ItemsSource="{x:Bind ByCategory}" ItemTemplate="{StaticResource BarRow}">
                            <ItemsRepeater.Layout>
                                <StackLayout Spacing="12" />
                            </ItemsRepeater.Layout>
                        </ItemsRepeater>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource FaintCard}">
                    <StackPanel Spacing="12">
                        <TextBlock Text="BY SOURCE" Style="{StaticResource EyebrowMuted}" />
                        <ItemsRepeater ItemsSource="{x:Bind BySource}" ItemTemplate="{StaticResource BarRow}">
                            <ItemsRepeater.Layout>
                                <StackLayout Spacing="12" />
                            </ItemsRepeater.Layout>
                        </ItemsRepeater>
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</Page>
