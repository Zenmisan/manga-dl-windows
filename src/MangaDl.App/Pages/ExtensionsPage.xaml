<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="MangaDl.Pages.ExtensionsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:c="using:MangaDl.Controls"
    xmlns:m="using:MangaDl.Core"
    xmlns:h="using:MangaDl.Helpers"
    Background="{StaticResource BgBrush}">

    <Page.Resources>
        <!-- Extensions table row -->
        <DataTemplate x:Key="ExtensionRow" x:DataType="m:Extension">
            <Grid MinHeight="56" Padding="12,0" ColumnSpacing="16" BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,1,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="120" />
                    <ColumnDefinition Width="140" />
                    <ColumnDefinition Width="160" />
                    <ColumnDefinition Width="140" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                    <Border Width="36" Height="36" CornerRadius="9" Background="{x:Bind h:X.Hex(Color)}">
                        <TextBlock Text="{x:Bind Initial}" FontFamily="{StaticResource AntonFont}" FontSize="15" Foreground="{StaticResource FgBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="{x:Bind Name}" FontSize="14" FontWeight="Bold" Foreground="{StaticResource FgBrush}" VerticalAlignment="Center" />
                </StackPanel>
                <TextBlock Grid.Column="1" Text="{x:Bind Language}" FontSize="13" Foreground="{StaticResource FgSoftBrush}" VerticalAlignment="Center" />
                <TextBlock Grid.Column="2" Text="{x:Bind Version}" FontSize="13" Foreground="{StaticResource FgSoftBrush}" VerticalAlignment="Center" />
                <TextBlock Grid.Column="3" Text="{x:Bind h:X.ExtStatus(State)}" FontSize="12" FontWeight="Bold" Foreground="{x:Bind h:X.ExtStatusColor(State)}" VerticalAlignment="Center" />
                <Button Grid.Column="4" Content="{x:Bind h:X.ExtAction(State)}" Style="{x:Bind h:X.ExtActionStyle(State)}" HorizontalAlignment="Right" VerticalAlignment="Center" />
            </Grid>
        </DataTemplate>

        <!-- Source row -->
        <DataTemplate x:Key="SourceRow" x:DataType="m:Source">
            <Grid Padding="12,10" ColumnSpacing="14" BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,1,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Width="40" Height="40" CornerRadius="10" Background="{x:Bind h:X.Hex(Color)}">
                    <TextBlock Text="{x:Bind Initial}" FontFamily="{StaticResource AntonFont}" FontSize="16" Foreground="{StaticResource FgBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="{x:Bind Name}" FontSize="15" FontWeight="Bold" Foreground="{StaticResource FgBrush}" />
                    <TextBlock Text="{x:Bind Meta}" FontSize="12" Foreground="{StaticResource FgSubtleBrush}" />
                </StackPanel>
                <Button Grid.Column="2" Content="Popular" Style="{StaticResource PillButton}" Click="OnOpenSource" />
                <Button Grid.Column="3" Content="Latest" Style="{StaticResource PillButton}" Click="OnOpenSource" />
                <Button Grid.Column="4" Style="{StaticResource IconButton}" Foreground="{StaticResource FgSubtleBrush}" AutomationProperties.Name="Pin source">
                    <c:MdIcon Kind="Pin" Size="18" />
                </Button>
            </Grid>
        </DataTemplate>

        <!-- Migrate row -->
        <DataTemplate x:Key="MigrateRow" x:DataType="m:Manga">
            <Grid Padding="12,8" ColumnSpacing="16" BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,1,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="200" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Width="36" Height="54" CornerRadius="6" Background="{x:Bind h:X.Hex(Cover)}" />
                <TextBlock Grid.Column="1" Text="{x:Bind Title}" FontSize="14" FontWeight="Bold" Foreground="{StaticResource FgBrush}" VerticalAlignment="Center" />
                <TextBlock Grid.Column="2" Text="{x:Bind Source}" FontSize="13" Foreground="{StaticResource FgSubtleBrush}" VerticalAlignment="Center" />
                <Button Grid.Column="3" Content="Migrate" Style="{StaticResource SmallGhostButton}" VerticalAlignment="Center" Click="OnMigrate" />
            </Grid>
        </DataTemplate>
    </Page.Resources>

    <ScrollViewer Style="{StaticResource PageScroller}">
        <StackPanel Padding="40,28,40,40" Spacing="18">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="BROWSE" Style="{StaticResource PageTitle}" VerticalAlignment="Center" />
                <!-- Looks like a search field; opens global search -->
                <Button Grid.Column="1" Style="{StaticResource CardButton}" Width="340" Height="42" CornerRadius="12" Click="OnSearch"
                        HorizontalContentAlignment="Left" VerticalContentAlignment="Center"
                        Background="{StaticResource SurfaceRaisedBrush}" BorderBrush="{StaticResource TrackBrush}" BorderThickness="1"
                        Padding="14,0" AutomationProperties.Name="Search all sources">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <c:MdIcon Kind="Search" Size="18" Foreground="{StaticResource FgSubtleBrush}" />
                        <TextBlock Text="Search all sources" FontSize="14" Foreground="{StaticResource FgSubtleBrush}" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </Grid>

            <Grid BorderBrush="{StaticResource DividerStrongBrush}" BorderThickness="0,0,0,1">
                <StackPanel Orientation="Horizontal">
                    <RadioButton x:Name="SourcesTab" Content="Sources · 6" GroupName="BrowseTabs" Style="{StaticResource TabRadio}" Checked="OnTab" />
                    <RadioButton x:Name="ExtensionsTab" Content="Extensions" GroupName="BrowseTabs" Style="{StaticResource TabRadio}" IsChecked="True" Checked="OnTab" />
                    <RadioButton x:Name="MigrateTab" Content="Migrate" GroupName="BrowseTabs" Style="{StaticResource TabRadio}" Checked="OnTab" />
                </StackPanel>
            </Grid>

            <!-- ===== Sources ===== -->
            <StackPanel x:Name="SourcesPanel" Visibility="Collapsed" Spacing="6">
                <TextBlock Text="LAST USED" Style="{StaticResource Eyebrow}" Margin="0,4,0,4" />
                <ContentControl Content="{x:Bind LastUsed}" ContentTemplate="{StaticResource SourceRow}" HorizontalContentAlignment="Stretch" />
                <TextBlock Text="ALL SOURCES" Style="{StaticResource EyebrowMuted}" Margin="0,18,0,4" />
                <ItemsRepeater ItemsSource="{x:Bind Sources}" ItemTemplate="{StaticResource SourceRow}" />
            </StackPanel>

            <!-- ===== Extensions ===== -->
            <StackPanel x:Name="ExtensionsPanel" Spacing="18">
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <RadioButton Content="English" GroupName="ExtLang" Style="{StaticResource ChipRadio}" Height="34" FontSize="12" Padding="14,0" IsChecked="True" />
                    <RadioButton Grid.Column="1" Content="All languages" GroupName="ExtLang" Style="{StaticResource ChipRadio}" Height="34" FontSize="12" Padding="14,0" />
                    <ToggleButton Grid.Column="2" Content="Show 18+" Style="{StaticResource SmallChipToggle}" />
                    <TextBlock Grid.Column="4" Text="Index: Keiyoushi · refreshed [time]" FontSize="13" Foreground="{StaticResource FgSubtleBrush}" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <Button Grid.Column="5" Content="Update All · 2" Style="{StaticResource PrimaryButton}" Height="38" CornerRadius="10" />
                </Grid>
                <StackPanel>
                    <Grid Padding="12,8" ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition Width="140" />
                            <ColumnDefinition Width="160" />
                            <ColumnDefinition Width="140" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="EXTENSION" Style="{StaticResource TableHeader}" />
                        <TextBlock Grid.Column="1" Text="LANGUAGE" Style="{StaticResource TableHeader}" />
                        <TextBlock Grid.Column="2" Text="VERSION" Style="{StaticResource TableHeader}" />
                        <TextBlock Grid.Column="3" Text="STATUS" Style="{StaticResource TableHeader}" />
                        <TextBlock Grid.Column="4" Text="ACTION" Style="{StaticResource TableHeader}" HorizontalAlignment="Right" />
                    </Grid>
                    <ItemsRepeater ItemsSource="{x:Bind Extensions}" ItemTemplate="{StaticResource ExtensionRow}" />
                </StackPanel>
            </StackPanel>

            <!-- ===== Migrate ===== -->
            <StackPanel x:Name="MigratePanel" Visibility="Collapsed" Spacing="8">
                <TextBlock Text="Move a manga to another source and keep its read chapters, categories and tracking."
                           Style="{StaticResource BodyMuted}" Margin="0,0,0,8" />
                <ItemsRepeater ItemsSource="{x:Bind Library}" ItemTemplate="{StaticResource MigrateRow}" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
