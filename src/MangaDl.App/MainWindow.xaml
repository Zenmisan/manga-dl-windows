<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="MangaDl.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:c="using:MangaDl.Controls"
    Title="manga-dl">

    <Grid x:Name="Root" Background="{StaticResource BgBrush}" RequestedTheme="Dark">
        <Grid.RowDefinitions>
            <RowDefinition Height="40" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Custom title bar. Windows draws the min/max/close buttons on the right. -->
        <Grid x:Name="AppTitleBar"
              Background="{StaticResource TitleBarBrush}"
              BorderBrush="{StaticResource DividerStrongBrush}"
              BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal" Spacing="8" Margin="14,0,0,0" VerticalAlignment="Center">
                <Border Width="16" Height="16" CornerRadius="4" Background="{StaticResource AccentBrush}" />
                <TextBlock x:Name="TitleText" Text="manga-dl" FontSize="12" FontWeight="Bold" Foreground="{StaticResource FgBrush}" VerticalAlignment="Center" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- ===== Sidebar (232px) ===== -->
            <Grid x:Name="Sidebar"
                  Width="232"
                  Padding="12,20"
                  Background="{StaticResource NavBgBrush}"
                  BorderBrush="{StaticResource DividerStrongBrush}"
                  BorderThickness="0,0,1,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Spacing="2">
                    <TextBlock Text="MANGA-DL" Style="{StaticResource DisplayText}" FontSize="24" Margin="12,0,0,18" />

                    <RadioButton x:Name="NavLibrary" Tag="Library" Style="{StaticResource NavRadio}" Click="OnNavClick" AutomationProperties.Name="Library">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <c:MdIcon Kind="Library" Size="20" />
                            <TextBlock Grid.Column="1" Text="Library" VerticalAlignment="Center" />
                        </Grid>
                    </RadioButton>

                    <RadioButton x:Name="NavUpdates" Tag="Updates" Style="{StaticResource NavRadio}" Click="OnNavClick" AutomationProperties.Name="Updates, 8 new">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <c:MdIcon Kind="Updates" Size="20" />
                            <TextBlock Grid.Column="1" Text="Updates" VerticalAlignment="Center" />
                            <Border Grid.Column="2" Style="{StaticResource Badge}">
                                <TextBlock Text="8" Style="{StaticResource BadgeText}" />
                            </Border>
                        </Grid>
                    </RadioButton>

                    <RadioButton x:Name="NavHistory" Tag="History" Style="{StaticResource NavRadio}" Click="OnNavClick" AutomationProperties.Name="History">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <c:MdIcon Kind="History" Size="20" />
                            <TextBlock Grid.Column="1" Text="History" VerticalAlignment="Center" />
                        </Grid>
                    </RadioButton>

                    <RadioButton x:Name="NavBrowse" Tag="Browse" Style="{StaticResource NavRadio}" Click="OnNavClick" AutomationProperties.Name="Browse">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <c:MdIcon Kind="Browse" Size="20" />
                            <TextBlock Grid.Column="1" Text="Browse" VerticalAlignment="Center" />
                        </Grid>
                    </RadioButton>

                    <RadioButton x:Name="NavDownloads" Tag="Downloads" Style="{StaticResource NavRadio}" Click="OnNavClick" AutomationProperties.Name="Downloads, 3 in queue">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <c:MdIcon Kind="Download" Size="20" />
                            <TextBlock Grid.Column="1" Text="Downloads" VerticalAlignment="Center" />
                            <Border Grid.Column="2" Style="{StaticResource Badge}">
                                <TextBlock Text="3" Style="{StaticResource BadgeText}" />
                            </Border>
                        </Grid>
                    </RadioButton>

                    <RadioButton x:Name="NavStats" Tag="Stats" Style="{StaticResource NavRadio}" Click="OnNavClick" AutomationProperties.Name="Statistics">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <c:MdIcon Kind="Stats" Size="20" />
                            <TextBlock Grid.Column="1" Text="Stats" VerticalAlignment="Center" />
                        </Grid>
                    </RadioButton>
                </StackPanel>

                <StackPanel Grid.Row="2" Spacing="2">
                    <RadioButton x:Name="NavAllPages" Tag="AllPages" Style="{StaticResource NavRadio}" Click="OnNavClick" Visibility="Collapsed" AutomationProperties.Name="All pages (debug)">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <c:MdIcon Kind="List" Size="20" />
                            <TextBlock Grid.Column="1" Text="All pages (debug)" VerticalAlignment="Center" />
                        </Grid>
                    </RadioButton>

                    <RadioButton x:Name="NavNotifications" Tag="Notifications" Style="{StaticResource NavRadio}" Click="OnNavClick" AutomationProperties.Name="Notifications">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <c:MdIcon Kind="Mail" Size="20" />
                            <TextBlock Grid.Column="1" Text="Notifications" VerticalAlignment="Center" />
                        </Grid>
                    </RadioButton>

                    <RadioButton x:Name="NavSettings" Tag="Settings" Style="{StaticResource NavRadio}" Click="OnNavClick" AutomationProperties.Name="Settings">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <c:MdIcon Kind="Settings" Size="20" />
                            <TextBlock Grid.Column="1" Text="Settings" VerticalAlignment="Center" />
                        </Grid>
                    </RadioButton>

                    <RadioButton x:Name="NavHelp" Tag="Help" Style="{StaticResource NavRadio}" Click="OnNavClick" AutomationProperties.Name="Help">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <c:MdIcon Kind="Help" Size="20" />
                            <TextBlock Grid.Column="1" Text="Help" VerticalAlignment="Center" />
                        </Grid>
                    </RadioButton>

                    <Border Height="1" Background="{StaticResource DividerStrongBrush}" Margin="0,8,0,0" />
                    <Button Style="{StaticResource CardButton}" Click="OnProfileClick" Padding="12" CornerRadius="10" AutomationProperties.Name="Open your profile">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Border Width="32" Height="32" CornerRadius="16" Background="#FF2D1716">
                                <TextBlock Text="U" FontSize="13" FontWeight="ExtraBold" Foreground="{StaticResource FgBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="[Username]" FontSize="13" FontWeight="Bold" Foreground="{StaticResource FgBrush}" />
                                <TextBlock Text="Synced · just now" FontSize="11" Foreground="{StaticResource FgSubtleBrush}" />
                            </StackPanel>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- ===== Page host ===== -->
            <Frame x:Name="ContentFrame" Grid.Column="1" />
        </Grid>

        <!-- ===== "Update ready" dialog ===== -->
        <Grid x:Name="UpdateOverlay" Grid.Row="1" Visibility="Collapsed">
            <Border Background="{StaticResource ScrimBrush}" Tapped="OnScrimTapped" />
            <Border Width="540"
                    Padding="32"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    CornerRadius="20"
                    Background="{StaticResource SheetBrush}"
                    BorderBrush="{StaticResource TrackBrush}"
                    BorderThickness="1">
                <StackPanel Spacing="18">
                    <TextBlock Text="UPDATE READY" Style="{StaticResource Eyebrow}" />
                    <TextBlock Text="MANGA-DL [VERSION]" Style="{StaticResource DisplayText}" FontSize="40" LineHeight="40" />
                    <TextBlock Text="You're on [current version]. The update is downloaded and verified." Style="{StaticResource BodyMuted}" />
                    <StackPanel Spacing="6">
                        <Grid>
                            <TextBlock Text="Downloaded" Style="{StaticResource Caption}" />
                            <TextBlock Text="100%" Style="{StaticResource Caption}" HorizontalAlignment="Right" />
                        </Grid>
                        <c:MdProgress Value="1" Height="6" Fill="{StaticResource SuccessBrush}" />
                    </StackPanel>
                    <Border Style="{StaticResource ListCard}" Padding="16">
                        <StackPanel Spacing="8">
                            <TextBlock Text="WHAT'S NEW" Style="{StaticResource EyebrowMuted}" />
                            <TextBlock Text="[Release note line from the changelog]" Style="{StaticResource Body}" FontSize="13" Foreground="{StaticResource FgStrongBrush}" />
                            <TextBlock Text="[Release note line from the changelog]" Style="{StaticResource Body}" FontSize="13" Foreground="{StaticResource FgStrongBrush}" />
                            <TextBlock Text="[Release note line from the changelog]" Style="{StaticResource Body}" FontSize="13" Foreground="{StaticResource FgStrongBrush}" />
                        </StackPanel>
                    </Border>
                    <CheckBox Content="Install updates automatically" IsChecked="True" Style="{StaticResource MdCheckBox}" FontSize="13" />
                    <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right">
                        <Button Content="Later" Style="{StaticResource GhostButton}" Height="46" FontSize="14" Click="OnUpdateLater" />
                        <Button Content="Restart &amp; Install" Style="{StaticResource PrimaryButton}" Height="46" FontSize="14" Click="OnUpdateInstall" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ===== Toast ===== -->
        <Border x:Name="Toast"
                Grid.Row="1"
                Width="340"
                Margin="24"
                Padding="16,14"
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                CornerRadius="14"
                Background="{StaticResource ToastBrush}"
                BorderBrush="{StaticResource TrackBrush}"
                BorderThickness="1"
                Visibility="Collapsed">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Width="32" Height="32" CornerRadius="16" Background="{StaticResource SuccessSoftBrush}">
                    <c:MdIcon Kind="Check" Size="16" Foreground="{StaticResource SuccessTextBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <TextBlock x:Name="ToastText" Grid.Column="1" Text="" Style="{StaticResource Body}" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
                <Button Grid.Column="2" Content="Open" Style="{StaticResource LinkButton}" FontSize="12" Click="OnToastClose" />
            </Grid>
        </Border>
    </Grid>
</Window>
