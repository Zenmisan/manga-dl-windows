<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        manga-dl design system. Tokens come from design.md / index.css.
        Everything lives in one dictionary so all pages share the same brush
        instances; ThemeService mutates the accent brushes for live accent changes.
    -->

    <!-- ===================== Fonts ===================== -->
    <FontFamily x:Key="AntonFont">ms-appx:///Assets/Fonts/Anton-Regular.ttf#Anton</FontFamily>
    <FontFamily x:Key="InterFont">ms-appx:///Assets/Fonts/InterVariable.ttf#Inter Variable</FontFamily>
    <FontFamily x:Key="SerifFont">ms-appx:///Assets/Fonts/PTSerif-Regular.ttf#PT Serif</FontFamily>

    <!-- ===================== Grounds ===================== -->
    <SolidColorBrush x:Key="BgBrush" Color="#FF050505" />
    <SolidColorBrush x:Key="NavBgBrush" Color="#FF080808" />
    <SolidColorBrush x:Key="TitleBarBrush" Color="#FF0A0A0A" />
    <SolidColorBrush x:Key="PanelBrush" Color="#FF0B0B0B" />
    <SolidColorBrush x:Key="SheetBrush" Color="#FF111111" />
    <SolidColorBrush x:Key="ToastBrush" Color="#FF161616" />
    <SolidColorBrush x:Key="ReaderBgBrush" Color="#FF000000" />
    <SolidColorBrush x:Key="NovelBgBrush" Color="#FF0D0D0D" />
    <SolidColorBrush x:Key="ScrimBrush" Color="#A6000000" />

    <!-- ===================== Text ===================== -->
    <SolidColorBrush x:Key="FgBrush" Color="#FFFAFAFA" />
    <SolidColorBrush x:Key="FgStrongBrush" Color="#D9FFFFFF" />
    <SolidColorBrush x:Key="FgSoftBrush" Color="#BFFFFFFF" />
    <SolidColorBrush x:Key="FgMutedBrush" Color="#B8FFFFFF" />
    <SolidColorBrush x:Key="FgSubtleBrush" Color="#99FFFFFF" />
    <SolidColorBrush x:Key="FgFaintBrush" Color="#8CFFFFFF" />
    <SolidColorBrush x:Key="PlaceholderBrush" Color="#73FFFFFF" />
    <SolidColorBrush x:Key="WhiteBrush" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="InkBrush" Color="#FF050505" />

    <!-- ===================== Surfaces and lines ===================== -->
    <SolidColorBrush x:Key="Surface3Brush" Color="#08FFFFFF" />
    <SolidColorBrush x:Key="Surface4Brush" Color="#0AFFFFFF" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="#0DFFFFFF" />
    <SolidColorBrush x:Key="SurfaceRaisedBrush" Color="#0FFFFFFF" />
    <SolidColorBrush x:Key="SurfaceHighBrush" Color="#14FFFFFF" />
    <SolidColorBrush x:Key="TrackBrush" Color="#1FFFFFFF" />
    <SolidColorBrush x:Key="LineBrush" Color="#24FFFFFF" />
    <SolidColorBrush x:Key="LineStrongBrush" Color="#2EFFFFFF" />
    <SolidColorBrush x:Key="DividerBrush" Color="#0FFFFFFF" />
    <SolidColorBrush x:Key="DividerStrongBrush" Color="#14FFFFFF" />
    <SolidColorBrush x:Key="SwitchOffBrush" Color="#33FFFFFF" />
    <SolidColorBrush x:Key="HoverBrush" Color="#12FFFFFF" />
    <SolidColorBrush x:Key="DarkChipBrush" Color="#59000000" />

    <!-- ===================== Accent (mutated by ThemeService) ===================== -->
    <SolidColorBrush x:Key="AccentBrush" Color="#FFDC2626" />
    <SolidColorBrush x:Key="AccentLightBrush" Color="#FFEF4444" />
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#FFFCA5A5" />
    <SolidColorBrush x:Key="AccentMutedBrush" Color="#29DC2626" />
    <SolidColorBrush x:Key="AccentFaintBrush" Color="#14DC2626" />
    <SolidColorBrush x:Key="AccentWashBrush" Color="#0DDC2626" />
    <SolidColorBrush x:Key="AccentNavBrush" Color="#2EDC2626" />

    <!-- ===================== Status ===================== -->
    <SolidColorBrush x:Key="SuccessBrush" Color="#FF16A34A" />
    <SolidColorBrush x:Key="SuccessTextBrush" Color="#FF4ADE80" />
    <SolidColorBrush x:Key="SuccessSoftBrush" Color="#2E16A34A" />
    <SolidColorBrush x:Key="SuccessWashBrush" Color="#0F16A34A" />
    <SolidColorBrush x:Key="SuccessLineBrush" Color="#5916A34A" />
    <SolidColorBrush x:Key="ErrorTextBrush" Color="#FFF87171" />
    <SolidColorBrush x:Key="ErrorBorderBrush" Color="#99EF4444" />
    <SolidColorBrush x:Key="ErrorSoftBrush" Color="#2EDC2626" />
    <SolidColorBrush x:Key="ErrorBarBrush" Color="#FF7F1D1D" />
    <SolidColorBrush x:Key="DangerBrush" Color="#FFB91C1C" />

    <!-- Page paper for reader placeholders -->
    <SolidColorBrush x:Key="PaperBrush" Color="#FFE9E6DF" />
    <SolidColorBrush x:Key="PaperPanelBrush" Color="#FFD4D0C6" />
    <SolidColorBrush x:Key="PaperInkBrush" Color="#FF1A1A1A" />
    <SolidColorBrush x:Key="PaperTextBrush" Color="#FF3A3A3A" />

    <!-- Blooms used behind hero text (set as a panel Background so they clip to it) -->
    <RadialGradientBrush x:Key="BloomTopLeftBrush" Center="0.1,0.08" GradientOrigin="0.1,0.08" RadiusX="0.8" RadiusY="0.6">
        <GradientStop Color="#38DC2626" Offset="0" />
        <GradientStop Color="#00DC2626" Offset="1" />
    </RadialGradientBrush>
    <RadialGradientBrush x:Key="BloomBottomLeftBrush" Center="0.15,1" GradientOrigin="0.15,1" RadiusX="0.85" RadiusY="0.65">
        <GradientStop Color="#33DC2626" Offset="0" />
        <GradientStop Color="#00DC2626" Offset="1" />
    </RadialGradientBrush>

    <!-- ===================== Text styles ===================== -->
    <Style x:Key="DisplayText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource AntonFont}" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="Foreground" Value="{StaticResource FgBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="LineStackingStrategy" Value="BlockLineHeight" />
        <Setter Property="OpticalMarginAlignment" Value="TrimSideBearings" />
    </Style>

    <Style x:Key="PageTitle" TargetType="TextBlock" BasedOn="{StaticResource DisplayText}">
        <Setter Property="FontSize" Value="44" />
        <Setter Property="LineHeight" Value="48" />
    </Style>

    <Style x:Key="Eyebrow" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource InterFont}" />
        <Setter Property="FontSize" Value="10" />
        <Setter Property="FontWeight" Value="Black" />
        <Setter Property="CharacterSpacing" Value="200" />
        <Setter Property="Foreground" Value="{StaticResource AccentLightBrush}" />
    </Style>

    <Style x:Key="EyebrowMuted" TargetType="TextBlock" BasedOn="{StaticResource Eyebrow}">
        <Setter Property="Foreground" Value="{StaticResource FgSubtleBrush}" />
    </Style>

    <Style x:Key="Body" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource InterFont}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Foreground" Value="{StaticResource FgBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="BodyMuted" TargetType="TextBlock" BasedOn="{StaticResource Body}">
        <Setter Property="Foreground" Value="{StaticResource FgMutedBrush}" />
        <Setter Property="LineHeight" Value="22" />
    </Style>

    <Style x:Key="Caption" TargetType="TextBlock" BasedOn="{StaticResource Body}">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{StaticResource FgSubtleBrush}" />
    </Style>

    <Style x:Key="ItemTitle" TargetType="TextBlock" BasedOn="{StaticResource Body}">
        <Setter Property="FontSize" Value="15" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="TextWrapping" Value="NoWrap" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <Style x:Key="SectionTitle" TargetType="TextBlock" BasedOn="{StaticResource Body}">
        <Setter Property="FontSize" Value="16" />
        <Setter Property="FontWeight" Value="ExtraBold" />
    </Style>

    <Style x:Key="FieldLabel" TargetType="TextBlock" BasedOn="{StaticResource Body}">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource FgStrongBrush}" />
        <Setter Property="Margin" Value="0,0,0,8" />
    </Style>

    <Style x:Key="TableHeader" TargetType="TextBlock" BasedOn="{StaticResource Body}">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="Black" />
        <Setter Property="CharacterSpacing" Value="150" />
        <Setter Property="Foreground" Value="{StaticResource FgFaintBrush}" />
    </Style>

    <!-- ===================== Buttons ===================== -->
    <!-- One template for every button: background, border, radius come from the style. -->
    <ControlTemplate x:Key="MdButtonTemplate" TargetType="Button">
        <Grid x:Name="Root"
              Background="{TemplateBinding Background}"
              BorderBrush="{TemplateBinding BorderBrush}"
              BorderThickness="{TemplateBinding BorderThickness}"
              CornerRadius="{TemplateBinding CornerRadius}">
            <VisualStateManager.VisualStateGroups>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal" />
                    <VisualState x:Name="PointerOver">
                        <VisualState.Setters>
                            <Setter Target="Hover.Opacity" Value="1" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Pressed">
                        <VisualState.Setters>
                            <Setter Target="Hover.Opacity" Value="0.6" />
                            <Setter Target="Root.Opacity" Value="0.85" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Disabled">
                        <VisualState.Setters>
                            <Setter Target="Root.Opacity" Value="0.4" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>
            <Border x:Name="Hover" Background="{StaticResource HoverBrush}" CornerRadius="{TemplateBinding CornerRadius}" Opacity="0" />
            <ContentPresenter x:Name="ContentPresenter"
                              Margin="{TemplateBinding Padding}"
                              Content="{TemplateBinding Content}"
                              ContentTemplate="{TemplateBinding ContentTemplate}"
                              ContentTransitions="{TemplateBinding ContentTransitions}"
                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                              Foreground="{TemplateBinding Foreground}"
                              FontFamily="{TemplateBinding FontFamily}"
                              FontSize="{TemplateBinding FontSize}"
                              FontWeight="{TemplateBinding FontWeight}" />
        </Grid>
    </ControlTemplate>

    <Style x:Key="MdButtonBase" TargetType="Button">
        <Setter Property="Template" Value="{StaticResource MdButtonTemplate}" />
        <Setter Property="FontFamily" Value="{StaticResource InterFont}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="ExtraBold" />
        <Setter Property="Height" Value="42" />
        <Setter Property="Padding" Value="18,0" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="UseSystemFocusVisuals" Value="True" />
    </Style>

    <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource MdButtonBase}">
        <Setter Property="Background" Value="{StaticResource AccentBrush}" />
        <Setter Property="Foreground" Value="{StaticResource WhiteBrush}" />
    </Style>

    <Style x:Key="GhostButton" TargetType="Button" BasedOn="{StaticResource MdButtonBase}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{StaticResource LineStrongBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="{StaticResource FgBrush}" />
        <Setter Property="FontWeight" Value="Bold" />
    </Style>

    <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource MdButtonBase}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{StaticResource ErrorBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="{StaticResource ErrorTextBrush}" />
        <Setter Property="FontWeight" Value="Bold" />
    </Style>

    <Style x:Key="DangerFillButton" TargetType="Button" BasedOn="{StaticResource MdButtonBase}">
        <Setter Property="Background" Value="{StaticResource DangerBrush}" />
        <Setter Property="Foreground" Value="{StaticResource WhiteBrush}" />
    </Style>

    <Style x:Key="SoftButton" TargetType="Button" BasedOn="{StaticResource MdButtonBase}">
        <Setter Property="Background" Value="{StaticResource AccentMutedBrush}" />
        <Setter Property="Foreground" Value="{StaticResource AccentSoftBrush}" />
    </Style>

    <Style x:Key="SuccessButton" TargetType="Button" BasedOn="{StaticResource MdButtonBase}">
        <Setter Property="Background" Value="{StaticResource SuccessSoftBrush}" />
        <Setter Property="Foreground" Value="{StaticResource SuccessTextBrush}" />
    </Style>

    <!-- Large CTA used on first-run screens -->
    <Style x:Key="PrimaryButtonLarge" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
        <Setter Property="Height" Value="50" />
        <Setter Property="FontSize" Value="15" />
    </Style>

    <Style x:Key="GhostButtonLarge" TargetType="Button" BasedOn="{StaticResource GhostButton}">
        <Setter Property="Height" Value="50" />
        <Setter Property="FontSize" Value="15" />
    </Style>

    <!-- Small pill buttons used inside rows -->
    <Style x:Key="PillButton" TargetType="Button" BasedOn="{StaticResource GhostButton}">
        <Setter Property="Height" Value="36" />
        <Setter Property="CornerRadius" Value="18" />
        <Setter Property="Padding" Value="14,0" />
        <Setter Property="FontSize" Value="12" />
    </Style>

    <Style x:Key="PillPrimaryButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
        <Setter Property="Height" Value="36" />
        <Setter Property="CornerRadius" Value="18" />
        <Setter Property="Padding" Value="14,0" />
        <Setter Property="FontSize" Value="12" />
    </Style>

    <!-- Compact row button (tables, settings rows) -->
    <Style x:Key="SmallGhostButton" TargetType="Button" BasedOn="{StaticResource GhostButton}">
        <Setter Property="Height" Value="36" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="14,0" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="ExtraBold" />
    </Style>

    <Style x:Key="SmallPrimaryButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
        <Setter Property="Height" Value="36" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="14,0" />
        <Setter Property="FontSize" Value="12" />
    </Style>

    <Style x:Key="SmallDangerButton" TargetType="Button" BasedOn="{StaticResource DangerButton}">
        <Setter Property="Height" Value="36" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="14,0" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="ExtraBold" />
    </Style>

    <!-- 44×44 icon-only button. Always set AutomationProperties.Name. -->
    <Style x:Key="IconButton" TargetType="Button" BasedOn="{StaticResource MdButtonBase}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource FgBrush}" />
        <Setter Property="Width" Value="44" />
        <Setter Property="Height" Value="44" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="CornerRadius" Value="10" />
    </Style>

    <!-- Red text link -->
    <Style x:Key="LinkButton" TargetType="Button" BasedOn="{StaticResource MdButtonBase}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource AccentLightBrush}" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Height" Value="Auto" />
        <Setter Property="Padding" Value="4,6" />
        <Setter Property="CornerRadius" Value="6" />
    </Style>

    <!-- Invisible chrome for clickable cards, covers and rows -->
    <Style x:Key="CardButton" TargetType="Button" BasedOn="{StaticResource MdButtonBase}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource FgBrush}" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="Height" Value="Auto" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Stretch" />
    </Style>

    <!-- ===================== Chips (ToggleButton) ===================== -->
    <Style x:Key="ChipToggle" TargetType="ToggleButton">
        <Setter Property="FontFamily" Value="{StaticResource InterFont}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource FgSoftBrush}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Height" Value="36" />
        <Setter Property="Padding" Value="16,0" />
        <Setter Property="CornerRadius" Value="18" />
        <Setter Property="UseSystemFocusVisuals" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Grid x:Name="Root"
                          Background="{TemplateBinding Background}"
                          BorderBrush="{TemplateBinding BorderBrush}"
                          BorderThickness="{TemplateBinding BorderThickness}"
                          CornerRadius="{TemplateBinding CornerRadius}">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="PointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="Hover.Opacity" Value="1" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <VisualState.Setters>
                                        <Setter Target="Hover.Opacity" Value="0.6" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Disabled">
                                    <VisualState.Setters>
                                        <Setter Target="Root.Opacity" Value="0.4" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Checked">
                                    <VisualState.Setters>
                                        <Setter Target="Root.Background" Value="{StaticResource FgBrush}" />
                                        <Setter Target="Root.BorderBrush" Value="Transparent" />
                                        <Setter Target="ContentPresenter.Foreground" Value="{StaticResource InkBrush}" />
                                        <Setter Target="ContentPresenter.FontWeight" Value="Bold" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="CheckedPointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="Root.Background" Value="{StaticResource FgBrush}" />
                                        <Setter Target="Root.BorderBrush" Value="Transparent" />
                                        <Setter Target="ContentPresenter.Foreground" Value="{StaticResource InkBrush}" />
                                        <Setter Target="ContentPresenter.FontWeight" Value="Bold" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="CheckedPressed">
                                    <VisualState.Setters>
                                        <Setter Target="Root.Background" Value="{StaticResource FgBrush}" />
                                        <Setter Target="Root.BorderBrush" Value="Transparent" />
                                        <Setter Target="ContentPresenter.Foreground" Value="{StaticResource InkBrush}" />
                                        <Setter Target="ContentPresenter.FontWeight" Value="Bold" />
                                        <Setter Target="Root.Opacity" Value="0.85" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="CheckedDisabled">
                                    <VisualState.Setters>
                                        <Setter Target="Root.Background" Value="{StaticResource FgBrush}" />
                                        <Setter Target="ContentPresenter.Foreground" Value="{StaticResource InkBrush}" />
                                        <Setter Target="Root.Opacity" Value="0.4" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <Border x:Name="Hover" Background="{StaticResource HoverBrush}" CornerRadius="{TemplateBinding CornerRadius}" Opacity="0" />
                        <ContentPresenter x:Name="ContentPresenter"
                                          Margin="{TemplateBinding Padding}"
                                          Content="{TemplateBinding Content}"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          Foreground="{TemplateBinding Foreground}"
                                          FontFamily="{TemplateBinding FontFamily}"
                                          FontSize="{TemplateBinding FontSize}"
                                          FontWeight="{TemplateBinding FontWeight}" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="SmallChipToggle" TargetType="ToggleButton" BasedOn="{StaticResource ChipToggle}">
        <Setter Property="Height" Value="34" />
        <Setter Property="Padding" Value="14,0" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="CornerRadius" Value="17" />
    </Style>

    <!-- Icon button that stays highlighted while on (reader settings panel) -->
    <Style x:Key="IconToggle" TargetType="ToggleButton" BasedOn="{StaticResource ChipToggle}">
        <Setter Property="Width" Value="44" />
        <Setter Property="Height" Value="44" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Foreground" Value="{StaticResource FgBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Grid x:Name="Root" Background="Transparent" CornerRadius="{TemplateBinding CornerRadius}">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="PointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="Root.Background" Value="{StaticResource HoverBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Pressed" />
                                <VisualState x:Name="Disabled">
                                    <VisualState.Setters>
                                        <Setter Target="Root.Opacity" Value="0.4" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Checked">
                                    <VisualState.Setters>
                                        <Setter Target="Root.Background" Value="{StaticResource AccentNavBrush}" />
                                        <Setter Target="ContentPresenter.Foreground" Value="{StaticResource AccentLightBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="CheckedPointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="Root.Background" Value="{StaticResource AccentNavBrush}" />
                                        <Setter Target="ContentPresenter.Foreground" Value="{StaticResource AccentLightBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="CheckedPressed">
                                    <VisualState.Setters>
                                        <Setter Target="Root.Background" Value="{StaticResource AccentNavBrush}" />
                                        <Setter Target="ContentPresenter.Foreground" Value="{StaticResource AccentLightBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="CheckedDisabled" />
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <ContentPresenter x:Name="ContentPresenter" Content="{TemplateBinding Content}"
                                          HorizontalAlignment="Center" VerticalAlignment="Center"
                                          Foreground="{TemplateBinding Foreground}" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===================== Switch (ToggleButton, 44×26) ===================== -->
    <Style x:Key="MdSwitch" TargetType="ToggleButton">
        <Setter Property="Width" Value="44" />
        <Setter Property="Height" Value="26" />
        <Setter Property="UseSystemFocusVisuals" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Grid x:Name="Root" Background="Transparent">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="PointerOver" />
                                <VisualState x:Name="Pressed" />
                                <VisualState x:Name="Disabled">
                                    <VisualState.Setters>
                                        <Setter Target="Root.Opacity" Value="0.4" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Checked">
                                    <VisualState.Setters>
                                        <Setter Target="Track.Background" Value="{StaticResource AccentBrush}" />
                                        <Setter Target="Knob.HorizontalAlignment" Value="Right" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="CheckedPointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="Track.Background" Value="{StaticResource AccentBrush}" />
                                        <Setter Target="Knob.HorizontalAlignment" Value="Right" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="CheckedPressed">
                                    <VisualState.Setters>
                                        <Setter Target="Track.Background" Value="{StaticResource AccentBrush}" />
                                        <Setter Target="Knob.HorizontalAlignment" Value="Right" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="CheckedDisabled">
                                    <VisualState.Setters>
                                        <Setter Target="Track.Background" Value="{StaticResource AccentBrush}" />
                                        <Setter Target="Knob.HorizontalAlignment" Value="Right" />
                                        <Setter Target="Root.Opacity" Value="0.4" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <Border x:Name="Track" CornerRadius="13" Background="{StaticResource SwitchOffBrush}" />
                        <Ellipse x:Name="Knob" Width="20" Height="20" Margin="3,0" Fill="{StaticResource WhiteBrush}" HorizontalAlignment="Left" VerticalAlignment="Center" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===================== RadioButton family ===================== -->
    <!-- Pill chip that is exclusive within its GroupName -->
    <Style x:Key="ChipRadio" TargetType="RadioButton">
        <Setter Property="FontFamily" Value="{StaticResource InterFont}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource FgSoftBrush}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Height" Value="36" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="Padding" Value="16,0" />
        <Setter Property="CornerRadius" Value="18" />
        <Setter Property="UseSystemFocusVisuals" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Grid x:Name="Root"
                          Background="{TemplateBinding Background}"
                          BorderBrush="{TemplateBinding BorderBrush}"
                          BorderThickness="{TemplateBinding BorderThickness}"
                          CornerRadius="{TemplateBinding CornerRadius}">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="PointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="Hover.Opacity" Value="1" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <VisualState.Setters>
                                        <Setter Target="Hover.Opacity" Value="0.6" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Disabled">
                                    <VisualState.Setters>
                                        <Setter Target="Root.Opacity" Value="0.4" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                            <VisualStateGroup x:Name="CheckStates">
                                <VisualState x:Name="Checked">
                                    <VisualState.Setters>
                                        <Setter Target="Root.Background" Value="{StaticResource FgBrush}" />
                                        <Setter Target="Root.BorderBrush" Value="Transparent" />
                                        <Setter Target="ContentPresenter.Foreground" Value="{StaticResource InkBrush}" />
                                        <Setter Target="ContentPresenter.FontWeight" Value="Bold" />
                                        <Setter Target="Hover.Visibility" Value="Collapsed" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Unchecked" />
                                <VisualState x:Name="Indeterminate" />
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <Border x:Name="Hover" Background="{StaticResource HoverBrush}" CornerRadius="{TemplateBinding CornerRadius}" Opacity="0" />
                        <ContentPresenter x:Name="ContentPresenter"
                                          Margin="{TemplateBinding Padding}"
                                          Content="{TemplateBinding Content}"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          Foreground="{TemplateBinding Foreground}"
                                          FontFamily="{TemplateBinding FontFamily}"
                                          FontSize="{TemplateBinding FontSize}"
                                          FontWeight="{TemplateBinding FontWeight}" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Text tab with a red underline when selected -->
    <Style x:Key="TabRadio" TargetType="RadioButton">
        <Setter Property="FontFamily" Value="{StaticResource InterFont}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource FgSubtleBrush}" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Margin" Value="0,0,24,0" />
        <Setter Property="UseSystemFocusVisuals" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Grid x:Name="Root" Background="Transparent" Height="44">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="PointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="ContentPresenter.Foreground" Value="{StaticResource FgBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Pressed" />
                                <VisualState x:Name="Disabled">
                                    <VisualState.Setters>
                                        <Setter Target="Root.Opacity" Value="0.4" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                            <VisualStateGroup x:Name="CheckStates">
                                <VisualState x:Name="Checked">
                                    <VisualState.Setters>
                                        <Setter Target="ContentPresenter.Foreground" Value="{StaticResource FgBrush}" />
                                        <Setter Target="ContentPresenter.FontWeight" Value="ExtraBold" />
                                        <Setter Target="Underline.Opacity" Value="1" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Unchecked" />
                                <VisualState x:Name="Indeterminate" />
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <ContentPresenter x:Name="ContentPresenter"
                                          Content="{TemplateBinding Content}"
                                          VerticalAlignment="Center"
                                          Foreground="{TemplateBinding Foreground}"
                                          FontFamily="{TemplateBinding FontFamily}"
                                          FontSize="{TemplateBinding FontSize}"
                                          FontWeight="{TemplateBinding FontWeight}" />
                        <Border x:Name="Underline" Height="2" VerticalAlignment="Bottom" Background="{StaticResource AccentBrush}" Opacity="0" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Segmented control option (wrap a group in a SurfaceBrush border with 3–4px padding) -->
    <Style x:Key="SegmentRadio" TargetType="RadioButton">
        <Setter Property="FontFamily" Value="{StaticResource InterFont}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{StaticResource FgSoftBrush}" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="Height" Value="32" />
        <Setter Property="Padding" Value="12,0" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="UseSystemFocusVisuals" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Grid x:Name="Root" Background="Transparent" CornerRadius="{TemplateBinding CornerRadius}">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="PointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="ContentPresenter.Foreground" Value="{StaticResource FgBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Pressed" />
                                <VisualState x:Name="Disabled">
                                    <VisualState.Setters>
                                        <Setter Target="Root.Opacity" Value="0.4" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                            <VisualStateGroup x:Name="CheckStates">
                                <VisualState x:Name="Checked">
                                    <VisualState.Setters>
                                        <Setter Target="Root.Background" Value="{StaticResource FgBrush}" />
                                        <Setter Target="ContentPresenter.Foreground" Value="{StaticResource InkBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Unchecked" />
                                <VisualState x:Name="Indeterminate" />
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <ContentPresenter x:Name="ContentPresenter"
                                          Margin="{TemplateBinding Padding}"
                                          Content="{TemplateBinding Content}"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          Foreground="{TemplateBinding Foreground}"
                                          FontFamily="{TemplateBinding FontFamily}"
                                          FontSize="{TemplateBinding FontSize}"
                                          FontWeight="{TemplateBinding FontWeight}" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Reader-mode / option card: bordered tile, red border + tint when selected -->
    <Style x:Key="OptionRadio" TargetType="RadioButton">
        <Setter Property="FontFamily" Value="{StaticResource InterFont}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource FgStrongBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="Height" Value="44" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="UseSystemFocusVisuals" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Grid x:Name="Root" Background="Transparent" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{TemplateBinding CornerRadius}">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="PointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="Hover.Opacity" Value="1" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Pressed" />
                                <VisualState x:Name="Disabled">
                                    <VisualState.Setters>
                                        <Setter Target="Root.Opacity" Value="0.4" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                            <VisualStateGroup x:Name="CheckStates">
                                <VisualState x:Name="Checked">
                                    <VisualState.Setters>
                                        <Setter Target="Root.Background" Value="{StaticResource AccentMutedBrush}" />
                                        <Setter Target="Root.BorderBrush" Value="{StaticResource AccentBrush}" />
                                        <Setter Target="ContentPresenter.Foreground" Value="{StaticResource FgBrush}" />
                                        <Setter Target="ContentPresenter.FontWeight" Value="Bold" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Unchecked" />
                                <VisualState x:Name="Indeterminate" />
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <Border x:Name="Hover" Background="{StaticResource HoverBrush}" CornerRadius="{TemplateBinding CornerRadius}" Opacity="0" />
                        <ContentPresenter x:Name="ContentPresenter"
                                          Content="{TemplateBinding Content}"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          Foreground="{TemplateBinding Foreground}"
                                          FontFamily="{TemplateBinding FontFamily}"
                                          FontSize="{TemplateBinding FontSize}"
                                          FontWeight="{TemplateBinding FontWeight}" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Sidebar / settings sub-nav item. Content is laid out by the caller. -->
    <Style x:Key="NavRadio" TargetType="RadioButton">
        <Setter Property="FontFamily" Value="{StaticResource InterFont}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource FgMutedBrush}" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="Height" Value="44" />
        <Setter Property="Padding" Value="12,0" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="GroupName" Value="SidebarNav" />
        <Setter Property="UseSystemFocusVisuals" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Grid x:Name="Root" Background="Transparent" CornerRadius="{TemplateBinding CornerRadius}">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="PointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="Root.Background" Value="{StaticResource HoverBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Pressed" />
                                <VisualState x:Name="Disabled" />
                            </VisualStateGroup>
                            <VisualStateGroup x:Name="CheckStates">
                                <VisualState x:Name="Checked">
                                    <VisualState.Setters>
                                        <Setter Target="Selected.Opacity" Value="1" />
                                        <Setter Target="ContentPresenter.Foreground" Value="{StaticResource FgBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Unchecked" />
                                <VisualState x:Name="Indeterminate" />
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <Border x:Name="Selected" Background="{StaticResource AccentMutedBrush}" CornerRadius="{TemplateBinding CornerRadius}" Opacity="0" />
                        <ContentPresenter x:Name="ContentPresenter"
                                          Margin="{TemplateBinding Padding}"
                                          Content="{TemplateBinding Content}"
                                          HorizontalAlignment="Stretch"
                                          HorizontalContentAlignment="Stretch"
                                          VerticalAlignment="Center"
                                          Foreground="{TemplateBinding Foreground}"
                                          FontFamily="{TemplateBinding FontFamily}"
                                          FontSize="{TemplateBinding FontSize}"
                                          FontWeight="{TemplateBinding FontWeight}" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===================== Inputs ===================== -->
    <Style x:Key="MdTextBox" TargetType="TextBox" BasedOn="{StaticResource DefaultTextBoxStyle}">
        <Setter Property="FontFamily" Value="{StaticResource InterFont}" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="MinHeight" Value="48" />
        <Setter Property="Padding" Value="14,13,14,0" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <Style x:Key="MdPasswordBox" TargetType="PasswordBox" BasedOn="{StaticResource DefaultPasswordBoxStyle}">
        <Setter Property="FontFamily" Value="{StaticResource InterFont}" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="MinHeight" Value="48" />
        <Setter Property="Padding" Value="14,13,14,0" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <!-- Error state for text fields -->
    <Style x:Key="MdPasswordBoxError" TargetType="PasswordBox" BasedOn="{StaticResource MdPasswordBox}">
        <Setter Property="BorderBrush" Value="{StaticResource ErrorBorderBrush}" />
        <Setter Property="Background" Value="{StaticResource AccentFaintBrush}" />
    </Style>

    <Style x:Key="MdCheckBox" TargetType="CheckBox" BasedOn="{StaticResource DefaultCheckBoxStyle}">
        <Setter Property="FontFamily" Value="{StaticResource InterFont}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Foreground" Value="{StaticResource FgStrongBrush}" />
        <Setter Property="MinHeight" Value="40" />
    </Style>

    <!-- ===================== Surfaces ===================== -->
    <Style x:Key="Card" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource SurfaceRaisedBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource DividerStrongBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="16" />
        <Setter Property="Padding" Value="20" />
    </Style>

    <Style x:Key="FaintCard" TargetType="Border" BasedOn="{StaticResource Card}">
        <Setter Property="Background" Value="{StaticResource Surface3Brush}" />
    </Style>

    <Style x:Key="ListCard" TargetType="Border" BasedOn="{StaticResource Card}">
        <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
        <Setter Property="CornerRadius" Value="14" />
        <Setter Property="Padding" Value="12" />
    </Style>

    <Style x:Key="HairLine" TargetType="Border">
        <Setter Property="Height" Value="1" />
        <Setter Property="Background" Value="{StaticResource DividerBrush}" />
    </Style>

    <Style x:Key="Badge" TargetType="Border">
        <Setter Property="MinWidth" Value="22" />
        <Setter Property="Height" Value="20" />
        <Setter Property="Padding" Value="6,0" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Background" Value="{StaticResource AccentBrush}" />
    </Style>

    <Style x:Key="BadgeText" TargetType="TextBlock" BasedOn="{StaticResource Body}">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="ExtraBold" />
        <Setter Property="Foreground" Value="{StaticResource WhiteBrush}" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="PageScroller" TargetType="ScrollViewer">
        <Setter Property="HorizontalScrollMode" Value="Disabled" />
        <Setter Property="HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
    </Style>

</ResourceDictionary>
